wenyou.site {
	handle /api/v1/* {
		reverse_proxy localhost:3000
	}
	handle /_next/webpack-hmr* {
		reverse_proxy localhost:3001
	}
	handle {
		reverse_proxy localhost:3001
	}

	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"

	request_body {
		max_size 10MB
	}

	encode gzip zstd
}

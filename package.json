{
  "name": "wenyousite-backend",
  "version": "0.1.0",
  "description": "温油站 - 共同创作社区后端",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "openapi:export": "ts-node --files scripts/export-openapi.ts",
    "contract:generate": "pnpm openapi:export contracts/openapi.json",
    "mobile:coverage:generate": "tsx scripts/generate-mobile-v1-coverage.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "markdown:v3:migrate": "tsx scripts/migrate-markdown-v3.ts",
    "media:gif-metadata:audit": "tsx scripts/audit-gif-metadata.ts",
    "media:references:audit": "tsx scripts/backfill-media-references.ts",
    "media:references:backfill": "tsx scripts/backfill-media-references.ts --apply",
    "loadtest:fixtures": "tsx loadtest/generate-fixtures.ts",
    "loadtest:tokens": "tsx scripts/generate-loadtest-tokens.ts",
    "media:latency:summary": "tsx loadtest/summarize-media-log.ts",
    "test:cleanup": "tsx scripts/cleanup-testuser.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --maxWorkers=2",
    "test:e2e:auth-terminal": "AUTH_TERMINAL_E2E_ENV=test ts-node --transpile-only scripts/auth-terminal-e2e.ts",
    "test:e2e:economy-terminal": "ECONOMY_TERMINAL_E2E_ENV=test ts-node --transpile-only scripts/economy-terminal-e2e.ts",
    "test:e2e:client": "tsx scripts/api-e2e-test.ts",
    "test:e2e": "API_E2E_ISOLATED_ENV=test tsx scripts/api-e2e-isolated.ts",
    "test:integration:bookmark-management": "BOOKMARK_MANAGEMENT_TEST_ENV=test tsx scripts/bookmark-folder-management.integration.ts",
    "test:integration:bookmark-count": "BOOKMARK_COUNT_TEST_ENV=test tsx scripts/bookmark-visible-count.integration.ts",
    "test:mobile-release": "bash scripts/mobile-release.test.sh",
    "test:host-health-monitor": "bash scripts/host-health-monitor.test.sh",
    "test:deploy-preflight": "bash scripts/assert-releasable-repo.test.sh",
    "test:deploy-runtime": "bash scripts/wenyousite-backend-start.test.sh && bash scripts/wenyousite-image-worker-start.test.sh && bash scripts/deploy-worker-readiness.test.sh",
    "test:redis-durability": "bash scripts/redis-durability.test.sh",
    "test:data-security": "bash scripts/redis-durability.test.sh && bash scripts/generate-data-security-secrets.test.sh && bash scripts/validate-production-security.test.sh",
    "test:data-security:integration": "bash scripts/harden-database-roles.integration.test.sh",
    "security:audit": "pnpm audit --prod && bash scripts/check-unsafe-sql.sh",
    "docs:generate": "tsx scripts/generate-api-endpoints.ts && tsx scripts/generate-error-code-doc.ts",
    "docs:check": "tsx scripts/check-doc-links.ts && tsx scripts/generate-api-endpoints.ts --check && tsx scripts/generate-error-code-doc.ts --check && tsx scripts/check-doc-truth.ts && tsx scripts/check-markdown-node-contract.ts && tsx scripts/check-markdown-block-boundary-contract.ts && tsx scripts/check-markdown-editor-contract.ts && tsx scripts/check-editor-clipboard-contract.ts && tsx scripts/check-internal-reference-contract.ts && tsx scripts/check-thread-category-contract.ts && tsx scripts/check-mobile-push-contract.ts && tsx scripts/generate-mobile-v1-coverage.ts --check && tsx scripts/check-mobile-v1-contract.ts && pnpm contract:rich-text --check",
    "arch:check": "tsx scripts/check-architecture.ts",
    "openapi:check": "bash scripts/check-openapi.sh",
    "test:openapi-runner": "bash scripts/check-openapi.test.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm arch:check && pnpm openapi:check && pnpm test:openapi-runner && pnpm test && pnpm test:rich-text && pnpm test:mobile-release && pnpm test:host-health-monitor && pnpm test:deploy-preflight && pnpm test:deploy-runtime && pnpm test:data-security && pnpm docs:check && pnpm build",
    "check:full": "pnpm security:audit && pnpm check && pnpm test:e2e:auth-terminal && pnpm test:e2e:economy-terminal && pnpm test:e2e && pnpm test:e2e:media-reclamation && pnpm test:e2e:ranking",
    "test:e2e:media-reclamation": "MEDIA_RECLAMATION_TEST_ENV=test tsx scripts/media-reclamation.integration.ts",
    "test:e2e:ranking": "THREAD_RANKING_TEST_ENV=test tsx scripts/thread-ranking.integration.ts",
    "test:search:benchmark": "SEARCH_BENCHMARK_ENV=test tsx scripts/search-benchmark.ts",
    "test:deploy-release:integration": "bash scripts/assemble-backend-release.integration.test.sh",
    "contract:rich-text": "tsx scripts/rich-text/cli.ts",
    "test:rich-text": "tsc -p scripts/rich-text/tsconfig.json && tsx --test scripts/rich-text/*.test.ts",
    "media:display:backfill": "tsx scripts/backfill-media-display.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "10.1.3",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.14.0",
    "@sentry/nestjs": "10.70.0",
    "@sentry/node": "10.70.0",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.54.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "firebase-admin": "14.3.0",
    "ioredis": "^5.7.0",
    "keyv": "^5.6.0",
    "markdown-it": "14.3.0",
    "nestjs-pino": "^4.2.0",
    "nodemailer": "9.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "prisma": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "remove-markdown": "^0.6.4",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.2.1",
    "@types/archiver": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.1",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/*.controller.ts",
      "!**/dto/**",
      "!**/types/**",
      "!main.ts",
      "!prisma/prisma.service.ts",
      "!common/swagger/openapi-document.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageProvider": "v8",
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./src/admin/admin-accounts.service.ts": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./src/admin/admin-auth.service.ts": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./src/admin/site-operational-settings.service.ts": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./src/moderation/moderation-cases.service.ts": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "./src/moments/moment-access.service.ts": {
        "branches": 75,
        "functions": 100,
        "lines": 90,
        "statements": 90
      },
      "./src/moments/moment-bookmarks.service.ts": {
        "branches": 70,
        "functions": 100,
        "lines": 88,
        "statements": 88
      },
      "./src/moments/moment-comments.service.ts": {
        "branches": 65,
        "functions": 85,
        "lines": 88,
        "statements": 88
      },
      "./src/moments/moments.service.ts": {
        "branches": 60,
        "functions": 90,
        "lines": 85,
        "statements": 85
      },
      "./src/reports/reports.service.ts": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  }
}

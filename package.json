{
  "name": "wenyousite-backend",
  "version": "0.1.0",
  "description": "温油站 - 共同创作社区后端",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 115",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "openapi:export": "ts-node --files scripts/export-openapi.ts",
    "contract:generate": "pnpm openapi:export contracts/openapi.json",
    "mobile:coverage:generate": "tsx scripts/generate-mobile-v1-coverage.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "markdown:v3:migrate": "tsx scripts/migrate-markdown-v3.ts",
    "test:cleanup": "tsx scripts/cleanup-testuser.ts",
    "test": "jest",
    "test:coverage": "jest --coverage --maxWorkers=2",
    "test:e2e:auth-terminal": "AUTH_TERMINAL_E2E_ENV=test ts-node --transpile-only scripts/auth-terminal-e2e.ts",
    "test:e2e:economy-terminal": "ECONOMY_TERMINAL_E2E_ENV=test ts-node --transpile-only scripts/economy-terminal-e2e.ts",
    "test:e2e": "tsx scripts/api-e2e-test.ts",
    "test:mobile-release": "bash scripts/mobile-release.test.sh",
    "docs:generate": "tsx scripts/generate-api-endpoints.ts && tsx scripts/generate-error-code-doc.ts",
    "docs:check": "tsx scripts/check-doc-links.ts && tsx scripts/generate-api-endpoints.ts --check && tsx scripts/generate-error-code-doc.ts --check && tsx scripts/check-doc-truth.ts && tsx scripts/check-markdown-node-contract.ts && tsx scripts/check-markdown-editor-contract.ts && tsx scripts/check-internal-reference-contract.ts && tsx scripts/check-thread-category-contract.ts && tsx scripts/check-mobile-push-contract.ts && tsx scripts/generate-mobile-v1-coverage.ts --check && tsx scripts/check-mobile-v1-contract.ts",
    "arch:check": "tsx scripts/check-architecture.ts",
    "openapi:check": "pnpm openapi:export /tmp/wenyousite-openapi-check.json && tsx scripts/check-openapi-contract.ts /tmp/wenyousite-openapi-check.json && tsx scripts/check-contract-artifact.ts /tmp/wenyousite-openapi-check.json && tsx scripts/check-contract-version.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm arch:check && pnpm openapi:check && pnpm test && pnpm test:mobile-release && pnpm docs:check && pnpm build",
    "check:full": "pnpm check && pnpm test:e2e:economy-terminal && API_E2E_ENV=test pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@dice-roller/rpg-dice-roller": "5.5.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.2",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.14",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.14.0",
    "@sentry/nestjs": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.54.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-stringify": "^6.8.3",
    "fastify": "^5.10.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "keyv": "^5.6.0",
    "markdown-it": "14.1.0",
    "nestjs-pino": "^4.2.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.4.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "remove-markdown": "^0.6.4",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.1",
    "picocolors": "^1.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.0",
    "prisma": "^6.14.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.3.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^4.4.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/*.controller.ts",
      "!**/dto/**",
      "!**/types/**",
      "!main.ts",
      "!prisma/prisma.service.ts",
      "!common/swagger/openapi-document.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageProvider": "v8",
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  }
}

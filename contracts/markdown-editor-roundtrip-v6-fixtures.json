{
  "contract": "wenyousite-markdown-editor-roundtrip",
  "version": 6,
  "markdownContractVersion": 4,
  "description": "Web 与 Flutter 编辑器共用的 Markdown v4 结构化编辑、块对齐语义、行内边界语义和字面纯文本黄金语料。",
  "modes": {
    "structured": "客户端应恢复为结构化编辑状态，并序列化为 serialized",
    "literal-text": "客户端显示源码字符但不得恢复为结构节点，并序列化为安全转义后的 serialized"
  },
  "cases": [
    {
      "id": "paragraphs",
      "capabilities": ["paragraph"],
      "mode": "structured",
      "markdown": "第一段\n\n第二段",
      "serialized": "第一段\n\n第二段"
    },
    {
      "id": "bold",
      "capabilities": ["bold"],
      "mode": "structured",
      "markdown": "普通 **粗体** 普通",
      "serialized": "普通 **粗体** 普通"
    },
    {
      "id": "bold-soft-break",
      "capabilities": ["bold", "soft-break"],
      "mode": "structured",
      "markdown": "**阿罗**\n下一行",
      "serialized": "**阿罗**\n下一行"
    },
    {
      "id": "italic",
      "capabilities": ["italic"],
      "mode": "structured",
      "markdown": "普通 *斜体* 普通",
      "serialized": "普通 *斜体* 普通"
    },
    {
      "id": "strikethrough",
      "capabilities": ["strikethrough"],
      "mode": "structured",
      "markdown": "保留 ~~删除线~~ 语义",
      "serialized": "保留 ~~删除线~~ 语义"
    },
    {
      "id": "nested-emphasis",
      "capabilities": ["bold", "italic"],
      "mode": "structured",
      "markdown": "***粗斜体***",
      "serialized": "***粗斜体***"
    },
    {
      "id": "attention-boundary-bold-live-content",
      "capabilities": ["bold"],
      "mode": "structured",
      "markdown": "选择你的DeerSeek模型：**【注意注意！并不是真的AI！DeerSeek就是我！】**DeerSeek v4 pro",
      "serialized": "选择你的DeerSeek模型：**【注意注意！并不是真的AI！DeerSeek就是我！】**&#x44;eerSeek v4 pro",
      "inlineSemantics": ["strong"]
    },
    {
      "id": "attention-boundary-italic",
      "capabilities": ["italic"],
      "mode": "structured",
      "markdown": "前*（斜体）*后",
      "serialized": "&#x524D;*（斜体）*&#x540E;",
      "inlineSemantics": ["emphasis"]
    },
    {
      "id": "attention-boundary-nested-emphasis",
      "capabilities": ["bold", "italic"],
      "mode": "structured",
      "markdown": "前***【粗斜体】***后",
      "serialized": "&#x524D;***【粗斜体】***&#x540E;",
      "inlineSemantics": ["emphasis", "strong"]
    },
    {
      "id": "attention-boundary-strikethrough",
      "capabilities": ["strikethrough"],
      "mode": "structured",
      "markdown": "前~~【删除】~~后",
      "serialized": "&#x524D;~~【删除】~~&#x540E;",
      "inlineSemantics": ["strikethrough"]
    },
    {
      "id": "attention-boundary-underscore-italic",
      "capabilities": ["italic"],
      "mode": "structured",
      "markdown": "前_（斜体）_后",
      "serialized": "&#x524D;*（斜体）*&#x540E;",
      "inlineSemantics": ["emphasis"]
    },
    {
      "id": "attention-boundary-underscore-bold",
      "capabilities": ["bold"],
      "mode": "structured",
      "markdown": "前__【粗体】__后",
      "serialized": "&#x524D;**【粗体】**&#x540E;",
      "inlineSemantics": ["strong"]
    },
    {
      "id": "attention-boundary-underscore-nested",
      "capabilities": ["bold", "italic"],
      "mode": "structured",
      "markdown": "前___【粗斜体】___后",
      "serialized": "&#x524D;***【粗斜体】***&#x540E;",
      "inlineSemantics": ["emphasis", "strong"]
    },
    {
      "id": "inline-code",
      "capabilities": ["inline-code"],
      "mode": "structured",
      "markdown": "运行 ``a`b`` 查看结果",
      "serialized": "运行 ``a`b`` 查看结果"
    },
    {
      "id": "safe-link",
      "capabilities": ["link"],
      "mode": "structured",
      "markdown": "查看 [站内帮助](https://wenyou.site/help)",
      "serialized": "查看 [站内帮助](https://wenyou.site/help)"
    },
    {
      "id": "creatable-headings",
      "capabilities": ["heading"],
      "mode": "structured",
      "markdown": "## 二级标题\n### 三级标题",
      "serialized": "## 二级标题\n### 三级标题"
    },
    {
      "id": "aligned-paragraphs",
      "capabilities": ["alignment"],
      "mode": "structured",
      "markdown": "[wenyousite-align-v1-center]: #\n第一段\n\n[wenyousite-align-v1-right]: #\n第二段",
      "serialized": "[wenyousite-align-v1-center]: #\n第一段\n\n[wenyousite-align-v1-right]: #\n第二段",
      "blockSemantics": ["paragraph", "paragraph"],
      "blockAlignments": ["center", "right"]
    },
    {
      "id": "aligned-headings",
      "capabilities": ["heading", "alignment"],
      "mode": "structured",
      "markdown": "[wenyousite-align-v1-center]: #\n## 二级标题\n\n[wenyousite-align-v1-right]: #\n### 三级标题",
      "serialized": "[wenyousite-align-v1-center]: #\n## 二级标题\n\n[wenyousite-align-v1-right]: #\n### 三级标题",
      "blockSemantics": ["heading-2", "heading-3"],
      "blockAlignments": ["center", "right"]
    },
    {
      "id": "setext-heading-2",
      "capabilities": ["heading"],
      "mode": "structured",
      "markdown": "正文\n---",
      "serialized": "## 正文",
      "blockSemantics": ["heading-2"]
    },
    {
      "id": "unsupported-heading-levels",
      "capabilities": ["heading"],
      "mode": "literal-text",
      "markdown": "# 一级标题\n#### 四级标题\n##### 五级标题\n###### 六级标题",
      "serialized": "\\# 一级标题\n\n\\#\\#\\#\\# 四级标题\n\n\\#\\#\\#\\#\\# 五级标题\n\n\\#\\#\\#\\#\\#\\# 六级标题"
    },
    {
      "id": "blockquote",
      "capabilities": ["quote"],
      "mode": "structured",
      "markdown": "> 引用内容",
      "serialized": "> 引用内容"
    },
    {
      "id": "bullet-list",
      "capabilities": ["bullet-list"],
      "mode": "structured",
      "markdown": "- 第一项\n- 第二项",
      "serialized": "- 第一项\n- 第二项"
    },
    {
      "id": "ordered-list",
      "capabilities": ["ordered-list"],
      "mode": "structured",
      "markdown": "1. 第一项\n1. 第二项",
      "serialized": "1. 第一项\n1. 第二项"
    },
    {
      "id": "nested-list",
      "capabilities": ["bullet-list"],
      "mode": "structured",
      "markdown": "- 第一层\n  - 第二层",
      "serialized": "- 第一层\n  - 第二层"
    },
    {
      "id": "empty-paragraph",
      "capabilities": ["paragraph"],
      "mode": "structured",
      "markdown": "第一段\n<br />\n第二段",
      "serialized": "第一段\n<br />\n第二段"
    },
    {
      "id": "horizontal-rule",
      "capabilities": ["hr"],
      "mode": "structured",
      "markdown": "正文\n\n---\n\n正文",
      "serialized": "正文\n\n---\n\n正文",
      "blockSemantics": ["paragraph", "horizontal-rule", "paragraph"]
    },
    {
      "id": "task-list-source",
      "capabilities": ["task-list"],
      "mode": "literal-text",
      "markdown": "- [ ] 未完成\n- [x] 已完成",
      "serialized": "\\- \\[ \\] 未完成\n\n\\- \\[x\\] 已完成"
    },
    {
      "id": "fenced-code-source",
      "capabilities": ["code-block"],
      "mode": "literal-text",
      "markdown": "```ts\nconst answer = 42;\n```",
      "serialized": "\\`\\`\\`ts\n\nconst answer \\= 42\\;\n\n\\`\\`\\`"
    },
    {
      "id": "table-source",
      "capabilities": ["table"],
      "mode": "literal-text",
      "markdown": "| 名称 | 数值 |\n| --- | ---: |\n| 骰子 | 20 |",
      "serialized": "\\| 名称 \\| 数值 \\|\n\n\\| \\-\\-\\- \\| \\-\\-\\-\\: \\|\n\n\\| 骰子 \\| 20 \\|"
    },
    {
      "id": "hard-break-source",
      "capabilities": ["hard-break"],
      "mode": "literal-text",
      "markdown": "第一行  \n第二行",
      "serialized": "第一行  ⁠\n\n第二行"
    }
  ]
}

{
  "contract": "wenyousite-markdown",
  "version": 2,
  "description": "Web、后端与 Flutter 共用的 Markdown v2 规范化和发布可见性黄金语料；v2 增加标准图片形式的收藏表情标记",
  "cases": [
    { "id": "plain-text", "description": "普通文字", "input": "这是一段正文", "canonical": "这是一段正文", "visible": true },
    { "id": "numeric-text", "description": "纯数字不是列表标记", "input": "123", "canonical": "123", "visible": true },
    { "id": "decimal-text", "description": "小数正文可发布", "input": "1.00", "canonical": "1.00", "visible": true },
    { "id": "line-endings", "description": "跨平台换行统一为 LF", "input": "第一段\r\n\r第二段", "canonical": "第一段\n\n第二段", "visible": true },
    { "id": "whitespace-only", "description": "纯空白不可发布", "input": " \t\n\n ", "canonical": " \t\n\n ", "visible": false },
    { "id": "empty-paragraph-variants", "description": "历史空段落写法规范化", "input": "<br>\n<br/>\n<br >\n<br />", "canonical": "<br />\n<br />\n<br />\n<br />", "visible": false },
    { "id": "inline-br-is-text", "description": "非独占 br 不作为空段落协议处理", "input": "正文 <br> 示例", "canonical": "正文 <br> 示例", "visible": true },
    { "id": "thematic-breaks-only", "description": "仅分隔线不可发布", "input": "---\n\n* * *\n___", "canonical": "---\n\n* * *\n___", "visible": false },
    { "id": "empty-ordered-list-marker", "description": "空有序列表标记不可发布", "input": "1.", "canonical": "1.", "visible": false },
    { "id": "ordered-list-content", "description": "有内容的列表可发布", "input": "1. 第一项", "canonical": "1. 第一项", "visible": true },
    { "id": "valid-image", "description": "有效图片可单独发布", "input": "![插图](https://cdn.example.com/a.png)", "canonical": "![插图](https://cdn.example.com/a.png)", "visible": true },
    { "id": "favorite-sticker", "description": "收藏表情使用标准 Markdown 图片和版本化 title 标记，可被旧客户端当普通图片显示", "input": "![表情](https://cdn.example.com/stickers/a.webp \"wenyousite-sticker:v1:sticker-asset-id\")", "canonical": "![表情](https://cdn.example.com/stickers/a.webp \"wenyousite-sticker:v1:sticker-asset-id\")", "visible": true },
    { "id": "empty-image", "description": "空 URL 图片被移除且不可发布", "input": "![1.00]()", "canonical": "", "visible": false },
    { "id": "empty-link", "description": "空 URL 链接不构成正文", "input": "[文字]()", "canonical": "[文字]()", "visible": false },
    { "id": "visible-link-label", "description": "有效链接的标签属于可见正文", "input": "[链接文字](https://example.com)", "canonical": "[链接文字](https://example.com)", "visible": true },
    { "id": "bare-http-link", "description": "裸 HTTP 链接可单独发布", "input": "https://wenyou.site/threads/example", "canonical": "https://wenyou.site/threads/example", "visible": true },
    { "id": "commonmark-http-autolink", "description": "CommonMark HTTP 自动链接可单独发布", "input": "<https://wenyou.site/threads/example>", "canonical": "<https://wenyou.site/threads/example>", "visible": true },
    { "id": "empty-fenced-code", "description": "空围栏代码块不可发布", "input": "```\n\n```", "canonical": "```\n\n```", "visible": false },
    { "id": "code-with-protocol-looking-text", "description": "代码块中的空段落和空图片写法保持原样并算代码内容", "input": "```html\r\n<br>\r\n![empty]()\r\n```", "canonical": "```html\n<br>\n![empty]()\n```", "visible": true },
    { "id": "long-fence-does-not-close-early", "description": "四反引号围栏不会被三个反引号提前关闭", "input": "````\n```\n正文\n```\n````", "canonical": "````\n```\n正文\n```\n````", "visible": true },
    { "id": "zero-width-only", "description": "仅默认不可见 Unicode 字符不可发布", "input": "​‍﻿", "canonical": "​‍﻿", "visible": false },
    { "id": "emoji-with-zwj", "description": "带零宽连接符的组合 Emoji 可发布", "input": "👨‍👩‍👧‍👦", "canonical": "👨‍👩‍👧‍👦", "visible": true },
    { "id": "html-only", "description": "仅 HTML 标签在禁用 HTML 的渲染策略下不可发布", "input": "<div></div>", "canonical": "<div></div>", "visible": false }
  ]
}

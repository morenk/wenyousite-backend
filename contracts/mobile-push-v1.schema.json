{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wenyou.site/contracts/mobile-push-v1.schema.json",
  "title": "WenyouSite mobile push data v1",
  "description": "FCM data payload contract. All values are strings; notification title/body are intentionally excluded.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "notificationId"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "kind": { "const": "notification" },
        "notificationId": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "conversationId", "messageId"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "kind": { "const": "direct_message" },
        "conversationId": { "type": "string", "minLength": 1 },
        "messageId": { "type": "string", "minLength": 1 }
      }
    }
  ]
}

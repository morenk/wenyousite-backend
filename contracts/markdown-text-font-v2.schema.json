{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenyou.site/contracts/markdown-text-font-v2.schema.json",
  "title": "温油站动态字体正文 v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "versionId",
    "content"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "versionId": {
      "type": "string",
      "pattern": "^tfv_[a-f0-9]{32}$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenyou.site/contracts/markdown-text-font-v1.schema.json",
  "title": "温油站文本字体 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fontId",
    "content"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "fontId": {
      "enum": [
        "source-han-sans",
        "zcoolkuaile",
        "zcoolxiaowei",
        "longcang",
        "liujianmaocao",
        "wenkai",
        "tiejili",
        "unbounded",
        "xiaolai",
        "zhuque",
        "fusion",
        "shinsyoku-mincho",
        "bouken-gothic",
        "hakkou-mincho",
        "shattered-display",
        "xiaocheng-lafeng",
        "jf-zsk-seal"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    }
  }
}

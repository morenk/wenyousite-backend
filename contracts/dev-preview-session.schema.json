{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "温油站私有开发预览消费者描述 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "sessionId",
    "runId",
    "state",
    "snapshot",
    "source",
    "backend",
    "media",
    "web",
    "identity",
    "ownership"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "wenyou-dev-preview"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,47}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^preview_[a-f0-9]{24}$"
    },
    "state": {
      "const": "ready"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "businessDate",
        "sha256",
        "sourceSha",
        "migrationVersion"
      ],
      "properties": {
        "capturedAt": {
          "type": "string"
        },
        "businessDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "migrationVersion": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendSha",
        "worktree"
      ],
      "properties": {
        "backendSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "worktree": {
          "type": "string"
        }
      }
    },
    "backend": {
      "$ref": "#/$defs/backend"
    },
    "media": {
      "$ref": "#/$defs/service"
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "origin"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/port"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "value"
      ],
      "properties": {
        "header": {
          "const": "X-Wenyou-Preview-Run"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "resourceId"
      ],
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "resourceId": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "not": {
        "enum": [
          3000,
          3001,
          5432,
          6379
        ]
      }
    },
    "origin": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "origin",
        "identityUrl"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/port"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "identityUrl": {
          "type": "string"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "origin",
        "apiBase",
        "identityUrl"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/port"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "apiBase": {
          "type": "string"
        },
        "identityUrl": {
          "type": "string"
        }
      }
    }
  }
}

{
  "contract": "wenyousite-mobile-v1",
  "version": 1,
  "contractVersion": "5.7.0-dev.20260823.1",
  "description": "后端与 Flutter 共同消费的移动端 V1 协议旅程；固定状态转换，不固定界面截图。",
  "compatibility": [
    {
      "id": "compatible-same-major",
      "clientMajor": 4,
      "serverVersion": "4.5.2-dev.20260811.1",
      "expected": "compatible"
    },
    {
      "id": "incompatible-new-major",
      "clientMajor": 4,
      "serverVersion": "5.0.0",
      "expected": "blocked"
    },
    {
      "id": "diagnostic-response-headers",
      "headers": ["X-Request-ID", "X-API-Contract-Version"],
      "expected": "capture"
    }
  ],
  "authentication": [
    {
      "id": "expired-access-token",
      "httpStatus": 401,
      "businessCode": 40101,
      "expectedKind": "tokenExpired",
      "sessionAction": "refreshSingleFlight",
      "maxReplayCount": 1
    },
    {
      "id": "invalid-access-token",
      "httpStatus": 401,
      "businessCode": 40102,
      "expectedKind": "tokenInvalid",
      "sessionAction": "clear"
    },
    {
      "id": "revoked-or-stolen-token",
      "httpStatus": 401,
      "businessCodes": [40103, 40104],
      "expectedKinds": ["tokenRevoked", "tokenTheftDetected"],
      "sessionAction": "clear"
    },
    {
      "id": "terminal-account-state",
      "httpStatus": 401,
      "businessCodes": [40106, 40108, 40109, 40115],
      "expectedKinds": [
        "accountDeactivated",
        "accountSuspended",
        "accountBanned",
        "sessionNotFound"
      ],
      "sessionAction": "clear"
    },
    {
      "id": "form-auth-errors",
      "httpStatus": 401,
      "businessCodes": [40105, 40110, 40111, 40112, 40113, 40114, 40116],
      "sessionAction": "formError",
      "preserveExistingSession": true
    },
    {
      "id": "punished-account-appeal-access",
      "ordinaryAccessBusinessCodes": [40108, 40109],
      "credentialExchangeOperation": "userModerationAppealsIssueToken",
      "appealTokenTtlSeconds": 900,
      "allowedOperations": ["userModerationAppealsMine", "userModerationAppealsAppeal"],
      "ordinarySessionAction": "preserveTerminalState",
      "appealCredentialStorage": "separateSecureScope"
    },
    {
      "id": "invalid-appeal-token",
      "httpStatus": 401,
      "businessCode": 40120,
      "expectedKind": "appealTokenInvalid",
      "appealCredentialAction": "clearAndReauthenticate",
      "ordinarySessionAction": "preserve"
    },
    {
      "id": "admin-client-authority",
      "operation": "clientContentModerationHide",
      "credential": "ordinaryAccessToken",
      "allowedRoles": ["ADMIN", "SUPER_ADMIN"],
      "stationSessionRequired": false,
      "csrfRequired": false,
      "emailStepUpRequired": false,
      "forbiddenBusinessCode": 40308
    },
    {
      "id": "unknown-401",
      "httpStatus": 401,
      "businessCode": null,
      "expectedKind": "unauthorized",
      "sessionAction": "clear"
    },
    {
      "id": "explicit-logout-transient-failure",
      "requestFailure": "networkOr5xx",
      "refreshOn40101": true,
      "maxRevokeReplayCount": 1,
      "sessionAction": "clear",
      "warning": "serverSessionMayRemain"
    },
    {
      "id": "registration-paused",
      "httpStatus": 409,
      "businessCode": 40924,
      "expectedKind": "registrationPaused",
      "sessionAction": "formError"
    },
    {
      "id": "content-writes-paused",
      "httpStatus": 409,
      "businessCode": 40925,
      "expectedKind": "contentWritesPaused",
      "sessionAction": "retain"
    }
  ],
  "retry": [
    {
      "id": "retry-get-network",
      "method": "GET",
      "failure": "network",
      "expectedExtraAttempts": 2
    },
    {
      "id": "retry-head-5xx",
      "method": "HEAD",
      "failure": "5xx",
      "expectedExtraAttempts": 2
    },
    {
      "id": "retry-idempotent-put-delete",
      "methods": ["PUT", "DELETE"],
      "failure": "networkOr5xx",
      "expectedExtraAttempts": 2
    },
    {
      "id": "retry-stable-create",
      "method": "POST",
      "stableClientRequestId": true,
      "failure": "networkOr5xx",
      "expectedExtraAttempts": 2
    },
    {
      "id": "no-retry-unsafe-or-client-errors",
      "methods": ["POST", "PATCH"],
      "failures": ["4xx", "429", "idempotencyConflict"],
      "stableClientRequestId": false,
      "expectedExtraAttempts": 0
    },
    {
      "id": "rate-limit-retry-after",
      "httpStatus": 429,
      "retryAfter": "42",
      "expectedDurationSeconds": 42,
      "automaticRetry": false
    }
  ],
  "pagination": [
    {
      "id": "opaque-cursor",
      "cursor": "opaque-value",
      "clientBehavior": "preserveVerbatim"
    },
    {
      "id": "invalid-cursor",
      "businessCode": 40007,
      "clientBehavior": "clearAndReloadFirstPage"
    }
  ],
  "postFloorAuthorFiltering": [
    {
      "id": "post-floor-author-filter-compatibility",
      "request": {
        "operationId": "postsFindFloors",
        "query": {}
      },
      "expected": {
        "defaultOrder": "OLDEST",
        "preserveCursorBehavior": true,
        "rootAuthorFilter": null,
        "previewAuthorFilter": null
      }
    },
    {
      "id": "post-floor-author-filter-owner",
      "member": {
        "userId": "11111111-1111-4111-8111-111111111111",
        "role": "OWNER",
        "playerMarked": true
      },
      "expected": {
        "includeInDirectory": true,
        "filterRootFloors": true
      }
    },
    {
      "id": "post-floor-author-filter-collaborator",
      "member": {
        "userId": "22222222-2222-4222-8222-222222222222",
        "role": "COLLABORATOR",
        "playerMarked": false
      },
      "expected": {
        "includeInDirectory": true,
        "filterRootFloors": true
      }
    },
    {
      "id": "post-floor-author-filter-player",
      "member": {
        "userId": "33333333-3333-4333-8333-333333333333",
        "role": "PARTICIPANT",
        "playerMarked": true
      },
      "expected": {
        "includeInDirectory": true,
        "filterRootFloors": true
      }
    },
    {
      "id": "post-floor-author-filter-participant-excluded",
      "member": {
        "userId": "44444444-4444-4444-8444-444444444444",
        "role": "PARTICIPANT",
        "playerMarked": false
      },
      "expected": {
        "includeInDirectory": false,
        "response": {
          "items": [],
          "cursor": null,
          "hasMore": false
        }
      }
    },
    {
      "id": "post-floor-author-filter-cursor-order",
      "request": {
        "operationId": "postsFindFloors",
        "query": {
          "authorId": "22222222-2222-4222-8222-222222222222",
          "order": "NEWEST",
          "cursor": "opaque-filtered-floor-cursor",
          "limit": 20
        }
      },
      "expected": {
        "rootQueryScope": ["authorId", "order", "cursor"],
        "preserveCursorVerbatim": true,
        "resetCursorWhenFilterChanges": true
      }
    },
    {
      "id": "post-floor-author-filter-preview-unaffected",
      "request": {
        "authorId": "22222222-2222-4222-8222-222222222222"
      },
      "rootFloor": {
        "id": "floor-by-collaborator",
        "authorId": "22222222-2222-4222-8222-222222222222"
      },
      "previewReplies": [
        {
          "id": "reply-by-other-author",
          "authorId": "55555555-5555-4555-8555-555555555555"
        }
      ],
      "expected": {
        "includeRootFloor": true,
        "includePreviewReplyIds": ["reply-by-other-author"]
      }
    },
    {
      "id": "post-floor-author-directory-current-subthread",
      "request": {
        "operationId": "postsFindFloorAuthors",
        "subthreadId": "current-subthread"
      },
      "content": [
        {
          "authorId": "22222222-2222-4222-8222-222222222222",
          "subthreadId": "current-subthread",
          "deleted": false,
          "eligibleRole": "COLLABORATOR"
        },
        {
          "authorId": "33333333-3333-4333-8333-333333333333",
          "subthreadId": "other-subthread",
          "deleted": false,
          "eligibleRole": "PARTICIPANT"
        }
      ],
      "expected": {
        "authorIds": ["22222222-2222-4222-8222-222222222222"],
        "scope": "currentSubthreadNonDeletedRootFloors"
      }
    },
    {
      "id": "post-reply-author-directory-current-root",
      "request": {
        "operationId": "postsFindReplyAuthors",
        "postId": "current-root-floor"
      },
      "content": [
        {
          "authorId": "33333333-3333-4333-8333-333333333333",
          "parentPostId": "current-root-floor",
          "deleted": false,
          "eligibleRole": "PARTICIPANT"
        },
        {
          "authorId": "11111111-1111-4111-8111-111111111111",
          "parentPostId": "other-root-floor",
          "deleted": false,
          "eligibleRole": "OWNER"
        }
      ],
      "expected": {
        "authorIds": ["33333333-3333-4333-8333-333333333333"],
        "scope": "currentRootNonDeletedReplies"
      }
    }
  ],
  "categories": [
    {
      "id": "category-current-name",
      "slug": "story",
      "storedName": "旧名称",
      "registryName": "共同创作",
      "expectedDisplay": "共同创作",
      "selectable": true
    },
    {
      "id": "category-unknown-history",
      "slug": "legacy-unknown",
      "expectedDisplay": "legacy-unknown",
      "selectable": false
    },
    {
      "id": "category-null",
      "slug": null,
      "expectedDisplay": "未分类",
      "selectable": false
    },
    {
      "id": "category-stable-sort",
      "items": [
        { "slug": "b", "name": "乙", "sortOrder": 10 },
        { "slug": "a", "name": "甲", "sortOrder": 10 },
        { "slug": "first", "name": "优先", "sortOrder": 1 }
      ],
      "expectedSlugs": ["first", "a", "b"]
    }
  ],
  "media": [
    {
      "id": "media-processing",
      "status": "PROCESSING",
      "expectedDisplay": "processing"
    },
    {
      "id": "media-feed-fallback",
      "status": "COMPLETED",
      "thumbnailUrl": null,
      "mediumUrl": "https://cdn.example/medium.jpg",
      "url": "https://cdn.example/original.jpg",
      "expectedUrl": "https://cdn.example/medium.jpg"
    },
    {
      "id": "media-detail-fallback",
      "status": "COMPLETED",
      "mediumUrl": null,
      "url": "https://cdn.example/original.jpg",
      "expectedUrl": "https://cdn.example/original.jpg"
    },
    {
      "id": "media-failed",
      "status": "FAILED",
      "expectedDisplay": "failed"
    }
  ],
  "profileCovers": [
    {
      "id": "profile-cover-mobile-present",
      "profileCover": {
        "url": "https://cdn.example/profile-web.webp",
        "mediumUrl": "https://cdn.example/profile-web-md.webp",
        "width": 1920,
        "height": 640,
        "mobile": {
          "url": "https://cdn.example/profile-mobile.webp",
          "mediumUrl": "https://cdn.example/profile-mobile-md.webp",
          "width": 1600,
          "height": 800
        }
      },
      "expectedSurface": "mobile"
    },
    {
      "id": "profile-cover-mobile-missing",
      "profileCover": {
        "url": "https://cdn.example/profile-web.webp",
        "mediumUrl": "https://cdn.example/profile-web-md.webp",
        "width": 1920,
        "height": 640,
        "mobile": null
      },
      "expectedSurface": "web"
    },
    {
      "id": "profile-cover-empty",
      "profileCover": null,
      "expectedSurface": "none"
    },
    {
      "id": "profile-cover-dual-write",
      "request": {
        "mediaId": "profile-web-media",
        "mobileMediaId": "profile-mobile-media"
      },
      "expectedMutation": "replaceBothAtomically"
    },
    {
      "id": "profile-cover-legacy-write",
      "request": {
        "mediaId": "profile-web-media"
      },
      "expectedMutation": "replaceWebAndClearMobile"
    },
    {
      "id": "profile-cover-remove",
      "operation": "usersRemoveProfileCover",
      "expectedMutation": "clearBoth"
    }
  ],
  "momentCommentNavigation": [
    {
      "id": "moment-comment-root-target",
      "notificationTarget": {
        "kind": "moment",
        "momentId": "moment-1",
        "momentCommentId": "root-1"
      },
      "contextRequest": {
        "operationId": "momentsCommentContext",
        "commentId": "root-1"
      },
      "contextResponse": {
        "rootId": "root-1",
        "rootDeleted": false,
        "targetId": "root-1",
        "targetParentCommentId": null,
        "replyCount": 2
      },
      "expected": {
        "injectRoot": true,
        "injectTargetReply": false,
        "expandReplies": false,
        "focusId": "root-1",
        "scanPagination": false
      }
    },
    {
      "id": "moment-comment-reply-target",
      "notificationTarget": {
        "kind": "moment",
        "momentId": "moment-1",
        "momentCommentId": "reply-1"
      },
      "contextRequest": {
        "operationId": "momentsCommentContext",
        "commentId": "reply-1"
      },
      "contextResponse": {
        "rootId": "root-1",
        "rootDeleted": false,
        "targetId": "reply-1",
        "targetParentCommentId": "root-1",
        "replyCount": 7
      },
      "expected": {
        "injectRoot": true,
        "injectTargetReply": true,
        "expandReplies": true,
        "focusId": "reply-1",
        "scanPagination": false
      }
    },
    {
      "id": "moment-comment-tombstone-root",
      "notificationTarget": {
        "kind": "moment",
        "momentId": "moment-1",
        "momentCommentId": "reply-1"
      },
      "contextRequest": {
        "operationId": "momentsCommentContext",
        "commentId": "reply-1"
      },
      "contextResponse": {
        "rootId": "root-1",
        "rootDeleted": true,
        "targetId": "reply-1",
        "targetParentCommentId": "root-1",
        "replyCount": 1
      },
      "expected": {
        "preserveRootTombstone": true,
        "injectTargetReply": true,
        "expandReplies": true,
        "focusId": "reply-1",
        "scanPagination": false
      }
    },
    {
      "id": "moment-comment-target-unavailable",
      "contextRequest": {
        "operationId": "momentsCommentContext",
        "commentId": "hidden-comment"
      },
      "httpStatus": 404,
      "expected": {
        "keepMomentDetail": true,
        "keepOrdinaryComments": true,
        "retryContext": false
      }
    },
    {
      "id": "moment-comment-context-transient-failure",
      "contextRequest": {
        "operationId": "momentsCommentContext",
        "commentId": "reply-1"
      },
      "httpStatus": 503,
      "expected": {
        "keepMomentDetail": true,
        "keepOrdinaryComments": true,
        "retryContext": true
      }
    }
  ],
  "idempotency": [
    {
      "id": "stable-client-request-id",
      "operation": "create",
      "sameUserIntent": true,
      "expected": "reuseUuidV4"
    },
    {
      "id": "new-intent-new-request-id",
      "operation": "create",
      "sameUserIntent": false,
      "expected": "newUuidV4"
    },
    {
      "id": "idempotency-key-conflict",
      "businessCode": 40912,
      "expectedKind": "idempotencyConflict",
      "automaticRetry": false
    },
    {
      "id": "optimistic-lock-conflict",
      "businessCode": 40002,
      "expectedKind": "optimisticLockConflict",
      "automaticRetry": false
    }
  ],
  "unknownEnums": [
    {
      "id": "unknown-enum-display",
      "wireValue": "FUTURE_VALUE",
      "expected": "unknownFallback"
    }
  ]
}

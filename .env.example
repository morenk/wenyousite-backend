NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://wenyou:wenyou@127.0.0.1:5432/wenyousite?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-to-random-string
JWT_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_WEB_TTL_DAYS=7
AUTH_REFRESH_MOBILE_TTL_DAYS=30

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

COS_ENDPOINT=https://cn-nb1.rains3.com
COS_REGION=auto
COS_BUCKET=wenyou
COS_ACCESS_KEY_ID=your-access-key
COS_SECRET_ACCESS_KEY=your-secret-key

# 图片上传每用户小时配额（防刷爆）
UPLOAD_RATE_PER_HOUR=60
DIRECT_MESSAGE_RATE_PER_MINUTE=30
DIRECT_MESSAGE_REQUEST_RATE_PER_DAY=10

SES_SMTP_HOST=smtpdm.aliyun.com
SES_SMTP_PORT=465
SES_SMTP_USER=noreply@mail.wenyou.site
SES_SMTP_PASS=your-password
SES_FROM_ADDRESS=noreply@mail.wenyou.site

SENTRY_DSN=

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
BUILD_SHA=
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
MOBILE_PUSH_TTL_SECONDS=86400
MOBILE_ANDROID_MIN_SUPPORTED_BUILD=
MOBILE_ANDROID_RECOMMENDED_BUILD=
# Android APK 由开发机上传 RainS3；这里仅保存不可变公网 HTTPS 地址
MOBILE_ANDROID_UPDATE_URL=
MOBILE_IOS_MIN_SUPPORTED_BUILD=
MOBILE_IOS_RECOMMENDED_BUILD=
MOBILE_IOS_UPDATE_URL=
LOG_LEVEL=info
# 日志文件目录（仅生产环境生效，不设则仅输出到控制台）
# LOG_FILE_DIR=/var/log/wenyousite

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://wenyou:wenyou@127.0.0.1:5432/wenyousite?schema=public
DIRECT_DATABASE_URL=postgresql://wenyou:wenyou@127.0.0.1:5432/wenyousite?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
# 全局每秒请求限流；正式环境保持默认 10，压测隔离实例单独覆盖
GLOBAL_RATE_LIMIT_PER_SECOND=10

JWT_ACCESS_SECRET=change-me-to-random-string
JWT_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_WEB_TTL_DAYS=7
AUTH_REFRESH_MOBILE_TTL_DAYS=30

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

COS_ENDPOINT=https://cn-nb1.rains3.com
COS_REGION=auto
COS_BUCKET=wenyou
COS_ACCESS_KEY_ID=your-access-key
COS_SECRET_ACCESS_KEY=your-secret-key

# 图片上传每用户小时配额（防刷爆）
UPLOAD_RATE_PER_HOUR=60
# 完成态孤儿图片需在引用回填与审计通过后显式启用
MEDIA_COMPLETED_ORPHAN_CLEANUP_ENABLED=false
DIRECT_MESSAGE_RATE_PER_MINUTE=30
DIRECT_MESSAGE_REQUEST_RATE_PER_DAY=10

SES_SMTP_HOST=smtpdm.aliyun.com
SES_SMTP_PORT=465
SES_SMTP_USER=noreply@mail.wenyou.site
SES_SMTP_PASS=your-password
SES_FROM_ADDRESS=noreply@mail.wenyou.site

SENTRY_DSN=

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
# 本示例值仅用于本地开发；生产未设置时默认 https://wenyou.site
WEB_APP_URL=http://localhost:3001
# 管理员邀请邮件落地页；生产环境必须使用可访问的 HTTPS /station/invite 地址
ADMIN_WEB_ENTRY_URL=http://localhost:3001/station/invite
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
ADMIN_STEP_UP_MINUTES=10
# 推荐独立随机值；未设置时生产环境从已校验的 JWT secret 做域隔离派生
ADMIN_CHALLENGE_PEPPER=change-me-to-an-independent-random-string
BUILD_SHA=
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
MOBILE_PUSH_TTL_SECONDS=86400
MOBILE_ANDROID_MIN_SUPPORTED_BUILD=
MOBILE_ANDROID_RECOMMENDED_BUILD=
# Android APK 由开发机上传 RainS3；这里仅保存不可变公网 HTTPS 地址
MOBILE_ANDROID_UPDATE_URL=
MOBILE_IOS_MIN_SUPPORTED_BUILD=
MOBILE_IOS_RECOMMENDED_BUILD=
MOBILE_IOS_UPDATE_URL=
LOG_LEVEL=info
# 日志文件目录（仅生产环境生效，不设则仅输出到控制台）
# LOG_FILE_DIR=/var/log/wenyousite

# Markdown 6 角色提及新写单独激活；兼容部署默认关闭
RP_MENTION_V6_ENABLED=false

# 音频新上传准入预算；同mediaId恢复不重复累计
AUDIO_MAX_ACTIVE_UPLOADS=2
AUDIO_DAILY_INPUT_BYTES=314572800

# 独立文本颜色 v1 新写；消费者完成保源发布后才明确启用
TEXT_COLOR_V1_ENABLED=false
# 字体资源完成发布与客户端验收后显式启用。
TEXT_FONT_V1_ENABLED=false
# 自有静态分发 HTTPS 前缀，末尾 /；未发布留空，新写保持关闭。
TEXT_FONT_ASSET_BASE_URL=

# v2 先完成私有存储、独立 Worker 与 28 款历史导入，再开启新写。
TEXT_FONT_V2_ENABLED=false
# API/Worker 沙箱工作目录；公网固定 /var/lib/wenyousite/font-work，0700。
TEXT_FONT_STORAGE_ROOT=
# 独立私有字体 bucket，使用现有 COS 连接；不得复用公共 COS_BUCKET。
TEXT_FONT_BUCKET=
# 独立锁定工具链的绝对路径；准备入口 pnpm text-font:prepare-toolchain。
TEXT_FONT_TOOLCHAIN_DIR=

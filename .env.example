NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://wenyou:wenyou@127.0.0.1:5432/wenyousite?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-to-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

COS_ENDPOINT=https://cn-nb1.rains3.com
COS_REGION=auto
COS_BUCKET=wenyou
COS_ACCESS_KEY_ID=your-access-key
COS_SECRET_ACCESS_KEY=your-secret-key

SES_SMTP_HOST=smtp.mxhichina.com
SES_SMTP_PORT=465
SES_SMTP_USER=noreply@wenyou.site
SES_SMTP_PASS=your-password
SES_FROM_ADDRESS=noreply@wenyou.site

SENTRY_DSN=

APP_URL=http://localhost:3000
LOG_LEVEL=info
# 日志文件目录（仅生产环境生效，不设则仅输出到控制台）
# LOG_FILE_DIR=/var/log/wenyousite

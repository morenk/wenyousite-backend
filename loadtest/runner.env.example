# Windows 本地 k6 压测机配置模板。
# 复制为 runner.env 后填写；runner.env 已被 Git 忽略。
# 这里不要填写数据库、Redis、RainS3 secret 或生产账号密码。

# 图片压测打隔离公网入口；核心只读压测仍可打正式开发域名。
BASE_URL=https://loadtest-api.wenyou.site
CORE_BASE_URL=https://wenyou.site

# 用于 Caddy/WAF 白名单的 Windows 本机固定公网 IPv4。
LOADGEN_IP=CHANGE_ME_LOADGEN_IP

# 由我在隔离数据库中生成专用账号 Token；不要手工放入 Git。
AUTH_TOKENS_JSON_PATH=.\loadtest\auth-tokens.json

# 结果目录只保留在压测机，完成后再回传摘要。
SUMMARY_DIR=.\loadtest\results

# core.js 默认基线：500 在线会话、50 RPS 读取、150 RPS 突发。
ONLINE_VUS=500
ONLINE_DURATION=10m
ONLINE_POLL_SECONDS=30
ACTIVE_RPS=50
ACTIVE_DURATION=8m
ACTIVE_VUS=100
ACTIVE_MAX_VUS=150
SPIKE_START=8m
SPIKE_RPS=150
SPIKE_MAX_VUS=300

# media.js 默认基线：4 个完整上传/秒、5 分钟。
MEDIA_RPS=4
MEDIA_DURATION=5m
MEDIA_PREALLOCATED_VUS=100
MEDIA_MAX_VUS=500
MEDIA_PUT_TIMEOUT=60s
MEDIA_PROCESS_TIMEOUT_MS=120000
MEDIA_POLL_SECONDS=0.5

# 固定夹具路径；执行前运行 pnpm loadtest:fixtures。
MEDIA_SMALL_FILE=.\loadtest\fixtures\small.png
MEDIA_MEDIUM_FILE=.\loadtest\fixtures\medium.png
MEDIA_LARGE_FILE=.\loadtest\fixtures\large.png

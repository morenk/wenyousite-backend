# 隔离图片压测后端/Worker配置模板。
# 复制为 loadtest/target.env 后填写；target.env 已被 Git 忽略。
# 不要把正式数据库、Redis 或 RainS3 凭据填到这里。

# 公网入口；我会据此配置 Caddy 和隔离服务。
LOADTEST_API_HOST=loadtest-api.wenyou.site
LOADTEST_API_PORT=3100
# 只允许 Windows 当前公网出口访问 API；不是 Windows 网卡的内网地址。
# 如果运营商出口地址会变化，在每轮测试前更新此值即可。
LOADTEST_ALLOWED_IP=CHANGE_ME_WINDOWS_EGRESS_IP

# 隔离 PostgreSQL；可先保留占位符，我会按此创建实例/数据库。
LOADTEST_DATABASE_URL=postgresql://wenyou_loadtest:CHANGE_ME_DB_PASSWORD@127.0.0.1:55432/wenyousite_loadtest?schema=public

# 隔离 Redis；不要使用正式实例的 Redis DB 0。
LOADTEST_REDIS_HOST=127.0.0.1
LOADTEST_REDIS_PORT=56379
LOADTEST_REDIS_DB=0

# 仅用于隔离实例，必须是新的随机值，不能复用正式 JWT secret。
LOADTEST_JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET
LOADTEST_JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET
LOADTEST_ADMIN_CHALLENGE_PEPPER=CHANGE_ME_RANDOM_ADMIN_PEPPER

# RainS3 专用测试实例/桶。不要填正式 wenyou 桶的凭据。
LOADTEST_COS_ENDPOINT=https://cn-nb1.rains3.com
LOADTEST_COS_REGION=auto
LOADTEST_COS_BUCKET=CHANGE_ME_LOADTEST_BUCKET
LOADTEST_COS_ACCESS_KEY_ID=CHANGE_ME_LOADTEST_ACCESS_KEY
LOADTEST_COS_SECRET_ACCESS_KEY=CHANGE_ME_LOADTEST_SECRET_KEY
# 测试桶只放合成图片；若要测派生图公网 GET，可开启测试桶公共读取。
LOADTEST_COS_PUBLIC_SYNTHETIC_BUCKET=false

# 隔离实例的限流与图片配额；正式服务仍保持原有策略。
LOADTEST_GLOBAL_RATE_LIMIT_PER_SECOND=1000
LOADTEST_UPLOAD_RATE_PER_HOUR=120
LOADTEST_MEDIA_COMPLETED_ORPHAN_CLEANUP_ENABLED=true

# 部署识别与跨域；图片 k6 测试不依赖邮件和推送。
LOADTEST_APP_URL=https://loadtest-api.wenyou.site
LOADTEST_CORS_ORIGINS=https://loadtest-api.wenyou.site
LOADTEST_BUILD_SHA=

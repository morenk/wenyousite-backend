[Unit]
Description=Wenyou Site Prisma migration with owner role
After=docker.service
Before=wenyousite-backend.service wenyousite-image-worker.service

[Service]
Type=oneshot
User=wenyousite-migrator
Group=wenyousite-migrator
SupplementaryGroups=wenyousite-runtime
WorkingDirectory=/var/lib/wenyousite/backend/current
EnvironmentFile=/etc/wenyousite/migration.env
ExecStart=/var/lib/wenyousite/backend/current/bin/node /var/lib/wenyousite/backend/current/node_modules/prisma/build/index.js migrate deploy
NoNewPrivileges=true
UMask=0027
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

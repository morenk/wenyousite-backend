[Unit]
Description=Wenyou Site restic retention and repository check
After=network-online.target
Wants=network-online.target
OnFailure=wenyousite-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/var/lib/wenyousite/backend/current/scripts/restic-maintenance.sh
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wenyousite/backup-state /var/cache/wenyousite/restic /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

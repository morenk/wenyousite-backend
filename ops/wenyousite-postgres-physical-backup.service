[Unit]
Description=Wenyou Site pgBackRest full/differential backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=wenyousite-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/wenyousite/compose.env
ExecStart=/var/lib/wenyousite/backend/current/scripts/backup-postgres-physical.sh auto
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wenyousite/backup-state /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

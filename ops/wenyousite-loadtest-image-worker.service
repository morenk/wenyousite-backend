[Unit]
Description=Wenyou Site isolated loadtest image worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/wenyousite/loadtest/current
EnvironmentFile=/etc/wenyousite/loadtest-base.env
EnvironmentFile=/etc/wenyousite/loadtest-backend.env
Environment=WENYOU_BACKEND_DIR=/var/lib/wenyousite/loadtest/current
Environment=WENYOU_NODE_BINARY=/usr/local/bin/node
ExecStart=/usr/local/sbin/wenyousite-loadtest-image-worker-start
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=Wenyou Site validated PostgreSQL logical backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=wenyousite-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/wenyousite/compose.env
Environment=WENYOUSITE_OFFSITE_REQUIRED=true
ExecStart=/var/lib/wenyousite/backend/current/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/wenyousite /var/lib/wenyousite/backup-state /var/cache/wenyousite/restic /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

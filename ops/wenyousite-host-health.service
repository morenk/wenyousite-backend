[Unit]
Description=Wenyou Site host health sampler
After=wenyousite-backend.service docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/libexec/wenyousite
ExecStart=/usr/local/libexec/wenyousite/monitor-host-health.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

[Unit]
Description=Wenyou Site host health sampler
After=wenyousite-backend.service docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/wenyousite/wenyousite-backend
ExecStart=/root/wenyousite/wenyousite-backend/scripts/monitor-host-health.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

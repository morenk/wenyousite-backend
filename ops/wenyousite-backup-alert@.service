[Unit]
Description=Wenyou Site backup failure email for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/wenyousite/alerts.env
ExecStart=/var/lib/wenyousite/backend/current/scripts/backup-alert.sh %i
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wenyousite/backup-state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

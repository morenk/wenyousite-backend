[Unit]
Description=Wenyou Site isolated PostgreSQL/Redis restore drill
After=docker.service network-online.target
Wants=network-online.target
OnFailure=wenyousite-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/wenyousite/compose.env
ExecStart=/var/lib/wenyousite/backend/current/scripts/restore-drill.sh
TimeoutStartSec=2h
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wenyousite/restore-candidates /var/lib/wenyousite/backup-state /var/cache/wenyousite/restic /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

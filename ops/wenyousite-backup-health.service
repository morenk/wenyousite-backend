[Unit]
Description=Wenyou Site backup RPO and durability monitor
After=docker.service
OnFailure=wenyousite-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/wenyousite/compose.env
ExecStart=/var/lib/wenyousite/backend/current/scripts/monitor-backup-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

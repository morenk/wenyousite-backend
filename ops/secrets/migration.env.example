# Copy to /etc/wenyousite/migration.env (0640 root:wenyousite-migrator).
# The application and worker users cannot read this owner credential.
DATABASE_URL=postgresql://wenyousite_owner:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:5432/wenyousite?schema=public
DIRECT_DATABASE_URL=postgresql://wenyousite_owner:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:5432/wenyousite?schema=public

# Merge these values into /etc/wenyousite/backend.env. Keep all existing app
# settings there as well; the repository .env is not read by public services.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://wenyousite_app:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:5432/wenyousite?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=wenyousite_app
REDIS_PASSWORD=CHANGE_ME_RANDOM_HEX

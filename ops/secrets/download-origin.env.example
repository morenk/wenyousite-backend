# 仅显式预热/修复的专用配置；root:wenyousite-download-publisher 0640。
# 可复用已有存储凭据，不要求新建，也不修改原权限而影响上传/图片。
# 代码固定 wenyou-apk/mobile/android/*，只发 HEAD/GET；不是云端权限保证。
# 泄漏仍可能影响凭据原有全部授权资源；绝不交给公开网关或写入日志。
DOWNLOAD_S3_ENDPOINT=https://cn-nb1.rains3.com
DOWNLOAD_S3_REGION=cn-nb1
DOWNLOAD_S3_ACCESS_KEY_ID=
DOWNLOAD_S3_SECRET_ACCESS_KEY=

# 无云、数据库或 Redis 凭据；root:wenyousite-download-cache 0640。
DOWNLOAD_SOCKET=/run/wenyousite-download/gateway.sock
DOWNLOAD_CACHE_DIR=/var/cache/wenyousite-download
DOWNLOAD_CATALOG_DIR=/var/lib/wenyousite-download/catalog
DOWNLOAD_EGRESS_DIR=/var/lib/wenyousite-download/egress
DOWNLOAD_ORIGIN_DIR=/var/lib/wenyousite-download/origin
# 仅管理身份在部署评审后调整；省略时为既定默认，不自动购买/扩容。
# DOWNLOAD_DAY_BYTES=5368709120
# DOWNLOAD_MONTH_BYTES=107374182400
# DOWNLOAD_ORIGIN_DAY_BYTES=536870912
# DOWNLOAD_ORIGIN_MONTH_BYTES=2147483648

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThreadCategory {
  DEDUCTION
  NATION
  RPG
}

enum ThreadStatus {
  RECRUITING
  CLOSED
  FINISHED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MemberRole {
  OWNER
  COLLABORATOR
  PARTICIPANT
}

enum PostingPolicy {
  PARTICIPANTS
  COLLABORATORS
  PLAYERS
}

enum PostKind {
  BODY
  FLOOR
}

enum ThreadVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  reply
  mention
  new_floor
  subthread_created
  new_post
  thread_created
  follow
  like
  system
}

enum SubscriptionType {
  THREAD
  USER
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  username         String   @unique
  password         String
  avatar           String?
  bio              String?
  role             UserRole @default(USER)
  emailVerified    Boolean  @default(false) @map("email_verified")
  showRecentReplies Boolean @default(true) @map("show_recent_replies")
  showPlayerBadges  Boolean @default(true) @map("show_player_badges")
  showBookmarks    Boolean  @default(true) @map("show_bookmarks")
  deletedAt    DateTime? @map("deleted_at")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil   DateTime? @map("locked_until")
  lastUsernameChange DateTime? @map("last_username_change")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ownedThreads Thread[]        @relation("ThreadOwner")
  threads      ThreadMember[]
  posts        Post[]
  drafts       Draft[]
  likedThreads  ThreadLike[]
  mentions     PostMention[]   @relation("mentionedUser")
  notifications Notification[]
  readProgress UserReadProgress[]

  userBlocks      UserBlock[]      @relation("Blocker")
  blockedBy       UserBlock[]      @relation("Blocked")
  following      UserFollow[]    @relation("Following")
  followers      UserFollow[]    @relation("Followers")
  emailVerifications EmailVerification[]
  subscriptions   Subscription[]
  sentNotifications Notification[] @relation("NotificationFromUser")
  reportedReports Report[]        @relation("Reporter")
  bookmarks    UserBookmark[]
  handledReports  Report[]        @relation("Handler")
  auditLogs       AuditLog[]      @relation("AuditAdmin")
  media           Media[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?
  token     String
  type      String   @default("REGISTRATION")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@unique([email, type])
  @@unique([userId, type])
  @@map("email_verifications")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  family     String
  platform   String?   @default("web")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model Thread {
  id         String  @id @default(cuid())
  title      String?
  ownerId    String  @map("owner_id")
  owner      User    @relation("ThreadOwner", fields: [ownerId], references: [id])

  category   ThreadCategory   @default(DEDUCTION)
  status     ThreadStatus     @default(RECRUITING)
  visibility ThreadVisibility @default(PUBLIC) @map("visibility")
  published  Boolean          @default(false) @map("published")
  publishedAt DateTime?       @map("published_at")

  pinned     Boolean   @default(false)
  pinnedAt   DateTime?

  viewCount  Int  @default(0)  @map("view_count")
  version    Int  @default(1)  @map("lock_version")
  likeCount  Int  @default(0)  @map("like_count")

  defaultSubthreadId String?    @unique @map("default_subthread_id")
  defaultSubthread   Subthread? @relation("DefaultSubthread", fields: [defaultSubthreadId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  members       ThreadMember[]
  subthreads    Subthread[]    @relation("ThreadSubthreads")
  subthreadTags SubthreadTagDef[]
  posts         Post[]
  topicTags     ThreadTopicTag[]
  subscriptions Subscription[]
  notifications Notification[]
  invites     ThreadInvite[]
  bookmarks    UserBookmark[]
  likes        ThreadLike[]

  @@map("threads")
}

model ThreadLike {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("thread_likes")
}

model ThreadMember {
  id           String   @id @default(cuid())
  threadId     String   @map("thread_id")
  userId       String   @map("user_id")
  role         MemberRole @default(PARTICIPANT)
  playerMarked Boolean  @default(false) @map("player_marked")
  joinedAt     DateTime @default(now()) @map("joined_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("thread_members")
}

model Subthread {
  id            String    @id @default(cuid())
  threadId      String    @map("thread_id")
  title         String
  sortOrder     Int       @default(0) @map("sort_order")
  postingPolicy PostingPolicy @default(PARTICIPANTS) @map("posting_policy")
  version       Int      @default(1) @map("lock_version")
  lastPostAt    DateTime? @map("last_post_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  thread        Thread    @relation("ThreadSubthreads", fields: [threadId], references: [id], onDelete: Cascade)
  defaultForThread Thread? @relation("DefaultSubthread")
  tags     SubthreadTag[]
  posts    Post[]
  readProgress UserReadProgress[]

  @@unique([threadId, sortOrder])
  @@map("subthreads")
}

model SubthreadTagDef {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  thread     Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  subthreads SubthreadTag[]

  @@unique([threadId, name])
  @@map("subthread_tag_defs")
}

model SubthreadTag {
  id          String    @id @default(cuid())
  subthreadId String    @map("subthread_id")
  tagId       String    @map("tag_id")

  subthread Subthread      @relation(fields: [subthreadId], references: [id], onDelete: Cascade)
  tag       SubthreadTagDef @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([subthreadId, tagId])
  @@map("subthread_tags")
}

model TopicTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  threads ThreadTopicTag[]

  @@map("topic_tags")
}

model ThreadTopicTag {
  id        String @id @default(cuid())
  threadId  String @map("thread_id")
  tagId     String @map("tag_id")

  thread Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    TopicTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([threadId, tagId])
  @@map("thread_topic_tags")
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  threadId     String   @map("thread_id")
  targetUserId String?  @map("target_user_id")
  type         SubscriptionType @default(THREAD)
  createdAt    DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@unique([userId, threadId, targetUserId])
  @@map("subscriptions")
}

model ThreadInvite {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId])
  @@map("thread_invites")
}

model UserBookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  threadId  String   @map("thread_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@map("user_bookmarks")
}

model Media {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  url       String
  key       String      @unique
  size      Int?
  width     Int?
  height    Int?
  status    MediaStatus @default(UPLOADING)
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media")
}

model Post {
  id            String    @id @default(cuid())
  threadId      String    @map("thread_id")
  subthreadId   String    @map("subthread_id")
  authorId      String    @map("author_id")
  kind          PostKind  @default(FLOOR) @map("kind")
  floorNumber   Int?      @map("floor_number")
  parentPostId  String?   @map("parent_post_id")
  replyToPostId String?   @map("reply_to_post_id")
  content       String
  version       Int      @default(1) @map("lock_version")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  subthread   Subthread @relation(fields: [subthreadId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])
  parentPost  Post?     @relation("PostReplies", fields: [parentPostId], references: [id])
  replyToPost Post?     @relation("ReplyTo", fields: [replyToPostId], references: [id])
  replies     Post[]    @relation("PostReplies")
  repliedBy   Post[]    @relation("ReplyTo")
  readProgressBy UserReadProgress[]
  mentions    PostMention[]
  notifications Notification[]
  @@index([subthreadId, kind])
  @@index([subthreadId, createdAt])
  @@index([threadId, createdAt])
  @@index([parentPostId, createdAt])
  @@unique([subthreadId, floorNumber])
  @@map("posts")
}

model PostMention {
  id              String   @id @default(cuid())
  postId          String   @map("post_id")
  mentionedUserId String   @map("mentioned_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  post          Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser User @relation("mentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId])
  @@map("post_mentions")
}

model Draft {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  slot      Int      @default(1)
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@map("drafts")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        NotificationType
  content     String?
  payload     Json?
  postId      String?  @map("post_id")
  threadId    String?  @map("thread_id")
  fromUserId  String?  @map("from_user_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  fromUser User? @relation("NotificationFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model Report {
  id         String    @id @default(cuid())
  reporterId String    @map("reporter_id")
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String
  status     String    @default("PENDING")
  handledBy  String?   @map("handled_by")
  handledAt  DateTime? @map("handled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  reporter User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handler  User? @relation("Handler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@map("reports")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  detail     String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UserReadProgress {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  subthreadId String   @map("subthread_id")
  postId      String?  @map("post_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subthread Subthread @relation(fields: [subthreadId], references: [id], onDelete: Cascade)
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([userId, subthreadId])
  @@map("user_read_progress")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
}

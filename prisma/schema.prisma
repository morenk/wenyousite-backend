generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThreadCategory {
  DEDUCTION
  NATION
  RPG
}

enum ThreadStatus {
  RECRUITING
  CLOSED
  FINISHED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MemberRole {
  OWNER
  COLLABORATOR
  PARTICIPANT
}

enum PostingPolicy {
  PARTICIPANTS
  COLLABORATORS
  PLAYERS
}

enum PostKind {
  BODY
  FLOOR
}

enum ThreadVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  reply
  mention
  new_floor
  subthread_created
  new_post
  thread_created
  follow
  like
  tip
  level_up
  system
}

enum WalletKind {
  USER
  PLATFORM
}

enum WalletTransactionType {
  DAILY_CHECK_IN
  TIP
}

enum TipTargetType {
  THREAD
  USER
}

enum ExperienceEventType {
  DAILY_CHECK_IN
  THREAD_PUBLISHED
  POST_CREATED
  THREAD_LIKED
  REVERSAL
}

enum MentionSource {
  DIRECT
  ALL_PLAYERS
}

enum SubscriptionType {
  THREAD
  USER
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum DirectConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum StickerImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MobilePlatform {
  ANDROID
  IOS
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  username            String    @unique
  password            String
  avatar              String?
  bio                 String?
  role                UserRole  @default(USER)
  emailVerified       Boolean   @default(false) @map("email_verified")
  showRecentReplies   Boolean   @default(true) @map("show_recent_replies")
  showPlayerBadges    Boolean   @default(true) @map("show_player_badges")
  showBookmarks       Boolean   @default(true) @map("show_bookmarks")
  deletedAt           DateTime? @map("deleted_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastUsernameChange  DateTime? @map("last_username_change")
  experience          Int       @default(0)
  level               Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  ownedThreads  Thread[]       @relation("ThreadOwner")
  threads       ThreadMember[]
  posts         Post[]
  drafts        Draft[]
  likedThreads  ThreadLike[]
  mentions      PostMention[]  @relation("mentionedUser")
  notifications Notification[]

  userBlocks                    UserBlock[]                     @relation("Blocker")
  blockedBy                     UserBlock[]                     @relation("Blocked")
  following                     UserFollow[]                    @relation("Following")
  followers                     UserFollow[]                    @relation("Followers")
  emailVerifications            EmailVerification[]
  subscriptions                 Subscription[]                  @relation("SubscriptionOwner")
  subscriptionsTargeting        Subscription[]                  @relation("SubscriptionTarget")
  sentNotifications             Notification[]                  @relation("NotificationFromUser")
  reportedReports               Report[]                        @relation("Reporter")
  bookmarks                     UserBookmark[]
  handledReports                Report[]                        @relation("Handler")
  auditLogs                     AuditLog[]                      @relation("AuditAdmin")
  media                         Media[]
  refreshTokens                 RefreshToken[]
  directConversationsAsFirst    DirectConversation[]            @relation("DirectConversationFirstUser")
  directConversationsAsSecond   DirectConversation[]            @relation("DirectConversationSecondUser")
  sentDirectRequests            DirectConversation[]            @relation("DirectConversationRequester")
  receivedDirectRequests        DirectConversation[]            @relation("DirectConversationRecipient")
  directConversationMemberships DirectConversationParticipant[]
  sentDirectMessages            DirectMessage[]                 @relation("DirectMessageSender")
  receivedDirectMessages        DirectMessage[]                 @relation("DirectMessageRecipient")
  stickerCollection             StickerCollection?
  stickers                      UserSticker[]
  stickerImports                StickerImport[]
  mobileDevices                 MobileDevice[]
  wallet                        Wallet?
  dailyCheckIns                 DailyCheckIn[]
  experienceEvents              ExperienceEvent[]
  experienceDailyStats          ExperienceDailyStat[]
  targetedTipTransactions       WalletTransaction[]             @relation("TipTargetUser")

  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@map("users")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?
  token     String
  type      String   @default("REGISTRATION")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, type])
  @@unique([userId, type])
  @@index([token])
  @@map("email_verifications")
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  tokenHash        String    @map("token_hash")
  family           String
  platform         String    @default("web")
  deviceInfo       String?   @map("device_info")
  sessionStartedAt DateTime  @default(now()) @map("session_started_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, family, revokedAt])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model MobileDevice {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  sessionId  String         @map("session_id")
  pushToken  String         @unique @map("push_token")
  platform   MobilePlatform
  appVersion String?        @map("app_version")
  locale     String?
  enabled    Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, enabled])
  @@map("mobile_devices")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model Thread {
  id      String  @id @default(cuid())
  title   String?
  ownerId String  @map("owner_id")
  owner   User    @relation("ThreadOwner", fields: [ownerId], references: [id])

  category          ThreadCategory   @default(DEDUCTION)
  status            ThreadStatus     @default(RECRUITING)
  visibility        ThreadVisibility @default(PUBLIC) @map("visibility")
  published         Boolean          @default(false) @map("published")
  publishedAt       DateTime?        @map("published_at")
  clientRequestId   String?          @map("client_request_id") @db.Uuid
  createRequestHash String?          @map("create_request_hash")

  pinned   Boolean   @default(false)
  pinnedAt DateTime?

  viewCount Int    @default(0) @map("view_count")
  version   Int    @default(1) @map("lock_version")
  likeCount Int    @default(0) @map("like_count")
  tipTotal  BigInt @default(0) @map("tip_total")

  defaultSubthreadId String?    @unique @map("default_subthread_id")
  defaultSubthread   Subthread? @relation("DefaultSubthread", fields: [defaultSubthreadId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members         ThreadMember[]
  subthreads      Subthread[]         @relation("ThreadSubthreads")
  posts           Post[]
  topicTags       ThreadTopicTag[]
  subscriptions   Subscription[]
  notifications   Notification[]
  invites         ThreadInvite[]
  bookmarks       UserBookmark[]
  likes           ThreadLike[]
  tipTransactions WalletTransaction[]

  @@unique([ownerId, clientRequestId])
  @@index([published, visibility, deletedAt, pinned(sort: Desc), createdAt(sort: Desc)], map: "threads_public_created_idx")
  @@index([published, visibility, deletedAt, pinned(sort: Desc), updatedAt(sort: Desc)], map: "threads_public_active_idx")
  @@index([ownerId, published, deletedAt, createdAt(sort: Desc)], map: "threads_owner_created_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "threads_title_trgm_idx")
  @@map("threads")
}

model ThreadLike {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("thread_likes")
}

model ThreadMember {
  id           String     @id @default(cuid())
  threadId     String     @map("thread_id")
  userId       String     @map("user_id")
  role         MemberRole @default(PARTICIPANT)
  playerMarked Boolean    @default(false) @map("player_marked")
  joinedAt     DateTime   @default(now()) @map("joined_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, playerMarked, joinedAt(sort: Desc)], map: "thread_members_user_played_idx")
  @@map("thread_members")
}

model Subthread {
  id                String        @id @default(cuid())
  threadId          String        @map("thread_id")
  title             String
  sortOrder         Int           @default(0) @map("sort_order")
  postingPolicy     PostingPolicy @default(PARTICIPANTS) @map("posting_policy")
  version           Int           @default(1) @map("lock_version")
  lastPostAt        DateTime?     @map("last_post_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  clientRequestId   String?       @map("client_request_id") @db.Uuid
  createRequestHash String?       @map("create_request_hash")

  thread           Thread  @relation("ThreadSubthreads", fields: [threadId], references: [id], onDelete: Cascade)
  defaultForThread Thread? @relation("DefaultSubthread")
  posts            Post[]

  @@unique([threadId, sortOrder])
  @@unique([threadId, clientRequestId])
  @@map("subthreads")
}

model TopicTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  threads ThreadTopicTag[]

  @@map("topic_tags")
}

model ThreadTopicTag {
  id       String @id @default(cuid())
  threadId String @map("thread_id")
  tagId    String @map("tag_id")

  thread Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    TopicTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([threadId, tagId])
  @@map("thread_topic_tags")
}

model Subscription {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  threadId     String           @map("thread_id")
  targetUserId String?          @map("target_user_id")
  type         SubscriptionType @default(THREAD)
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User   @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User?  @relation("SubscriptionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  thread     Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId, targetUserId])
  @@index([userId, type])
  @@map("subscriptions")
}

model ThreadInvite {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId])
  @@map("thread_invites")
}

model UserBookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  threadId  String   @map("thread_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@map("user_bookmarks")
}

model Media {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  url         String
  key         String      @unique
  contentType String?     @map("content_type")
  size        Int?
  width       Int?
  height      Int?
  status      MediaStatus @default(UPLOADING)
  createdAt   DateTime    @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  directMessage  DirectMessage?
  stickerImports StickerImport[]

  @@index([status, createdAt])
  @@map("media")
}

model StickerAsset {
  id           String   @id @default(cuid())
  url          String   @unique
  key          String   @unique
  thumbnailUrl String   @map("thumbnail_url")
  thumbnailKey String   @unique @map("thumbnail_key")
  contentHash  String   @unique @map("content_hash")
  contentType  String   @default("image/webp") @map("content_type")
  size         Int
  width        Int
  height       Int
  animated     Boolean  @default(false)
  frameCount   Int      @default(1) @map("frame_count")
  durationMs   Int      @default(0) @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  favorites      UserSticker[]
  imports        StickerImport[]
  directMessages DirectMessage[]

  @@index([createdAt])
  @@map("sticker_assets")
}

model StickerCollection {
  userId    String   @id @map("user_id")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sticker_collections")
}

model UserSticker {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  assetId    String    @map("asset_id")
  position   Int       @default(0)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset StickerAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([userId, assetId])
  @@index([userId, position, createdAt])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("user_stickers")
}

model StickerImport {
  id              String              @id @default(cuid())
  userId          String              @map("user_id")
  sourceMediaId   String?             @map("source_media_id")
  clientRequestId String              @map("client_request_id") @db.Uuid
  status          StickerImportStatus @default(PROCESSING)
  alreadySaved    Boolean             @default(false) @map("already_saved")
  assetId         String?             @map("asset_id")
  failureCode     String?             @map("failure_code")
  failureMessage  String?             @map("failure_message")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMedia Media?        @relation(fields: [sourceMediaId], references: [id], onDelete: SetNull)
  asset       StickerAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, status, createdAt])
  @@index([sourceMediaId, status])
  @@map("sticker_imports")
}

model DirectConversation {
  id            String                   @id @default(cuid())
  firstUserId   String                   @map("first_user_id")
  secondUserId  String                   @map("second_user_id")
  requesterId   String                   @map("requester_id")
  recipientId   String                   @map("recipient_id")
  status        DirectConversationStatus @default(PENDING)
  lastMessageAt DateTime?                @map("last_message_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  firstUser    User                            @relation("DirectConversationFirstUser", fields: [firstUserId], references: [id])
  secondUser   User                            @relation("DirectConversationSecondUser", fields: [secondUserId], references: [id])
  requester    User                            @relation("DirectConversationRequester", fields: [requesterId], references: [id])
  recipient    User                            @relation("DirectConversationRecipient", fields: [recipientId], references: [id])
  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@unique([firstUserId, secondUserId])
  @@index([status, recipientId, lastMessageAt(sort: Desc)], map: "direct_conversations_requests_idx")
  @@map("direct_conversations")
}

model DirectConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId, archivedAt, conversationId], map: "direct_conversation_participants_inbox_idx")
  @@map("direct_conversation_participants")
}

model DirectMessage {
  id              String    @id @default(cuid())
  conversationId  String    @map("conversation_id")
  senderId        String    @map("sender_id")
  recipientId     String    @map("recipient_id")
  mediaId         String?   @unique @map("media_id")
  stickerAssetId  String?   @map("sticker_asset_id")
  clientRequestId String    @map("client_request_id") @db.Uuid
  content         String?
  readAt          DateTime? @map("read_at")
  recalledAt      DateTime? @map("recalled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation("DirectMessageSender", fields: [senderId], references: [id])
  recipient    User               @relation("DirectMessageRecipient", fields: [recipientId], references: [id])
  media        Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  sticker      StickerAsset?      @relation(fields: [stickerAssetId], references: [id], onDelete: SetNull)

  @@unique([senderId, clientRequestId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "direct_messages_history_idx")
  @@index([recipientId, readAt, createdAt(sort: Desc)], map: "direct_messages_unread_idx")
  @@index([stickerAssetId])
  @@map("direct_messages")
}

model Post {
  id              String    @id @default(cuid())
  threadId        String    @map("thread_id")
  subthreadId     String    @map("subthread_id")
  authorId        String    @map("author_id")
  kind            PostKind  @default(FLOOR) @map("kind")
  floorNumber     Int?      @map("floor_number")
  parentPostId    String?   @map("parent_post_id")
  replyToPostId   String?   @map("reply_to_post_id")
  clientRequestId String?   @map("client_request_id") @db.Uuid
  content         String
  version         Int       @default(1) @map("lock_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  thread        Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  subthread     Subthread      @relation(fields: [subthreadId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])
  parentPost    Post?          @relation("PostReplies", fields: [parentPostId], references: [id])
  replyToPost   Post?          @relation("ReplyTo", fields: [replyToPostId], references: [id])
  replies       Post[]         @relation("PostReplies")
  repliedBy     Post[]         @relation("ReplyTo")
  mentions      PostMention[]
  notifications Notification[]
  diceRolls     DiceRoll[]

  @@unique([subthreadId, floorNumber])
  @@unique([authorId, clientRequestId])
  @@index([subthreadId, kind, deletedAt, floorNumber], map: "posts_floor_page_idx")
  @@index([subthreadId, kind])
  @@index([subthreadId, createdAt])
  @@index([threadId, createdAt])
  @@index([parentPostId, createdAt])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "posts_content_trgm_idx")
  @@map("posts")
}

model DiceRoll {
  id              String   @id @default(cuid())
  postId          String   @map("post_id")
  nodeId          String   @map("node_id") @db.Uuid
  protocolVersion Int      @default(1) @map("protocol_version")
  notation        String
  quantity        Int
  sides           Int
  modifier        Int      @default(0)
  results         Int[]
  total           Int
  createdAt       DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, nodeId])
  @@index([postId, createdAt])
  @@map("dice_rolls")
}

model PostMention {
  id              String        @id @default(cuid())
  postId          String        @map("post_id")
  mentionedUserId String        @map("mentioned_user_id")
  source          MentionSource @default(DIRECT)
  createdAt       DateTime      @default(now()) @map("created_at")

  post          Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser User @relation("mentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId, source])
  @@map("post_mentions")
}

model Draft {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  slot      Int      @default(1)
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@map("drafts")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  content    String?
  payload    Json?
  postId     String?          @map("post_id")
  threadId   String?          @map("thread_id")
  fromUserId String?          @map("from_user_id")
  eventKey   String           @default(dbgenerated("(gen_random_uuid())::text")) @map("event_key")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  fromUser User?   @relation("NotificationFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@unique([userId, eventKey])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model Report {
  id         String    @id @default(cuid())
  reporterId String    @map("reporter_id")
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String
  status     String    @default("PENDING")
  handledBy  String?   @map("handled_by")
  handledAt  DateTime? @map("handled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  reporter User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handler  User? @relation("Handler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@map("reports")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  detail     String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)], map: "user_follows_followers_idx")
  @@map("user_follows")
}

/// 与业务写入同事务提交的领域事件；由后台分发器可靠投递到进程内监听器和 BullMQ。
model DomainOutbox {
  id            String    @id @default(cuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id")
  eventKey      String    @unique @map("event_key")
  payload       Json
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([processedAt, availableAt, createdAt], map: "domain_outbox_pending_idx")
  @@map("domain_outbox")
}

model Wallet {
  id               String     @id @default(cuid())
  kind             WalletKind
  userId           String?    @unique @map("user_id")
  balance          BigInt     @default(0)
  receivedTipTotal BigInt     @default(0) @map("received_tip_total")
  receivedTipCount Int        @default(0) @map("received_tip_count")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user                 User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentTransactions     WalletTransaction[] @relation("WalletTransactionSender")
  receivedTransactions WalletTransaction[] @relation("WalletTransactionRecipient")
  platformTransactions WalletTransaction[] @relation("WalletTransactionPlatform")
  dailyCheckIns        DailyCheckIn[]

  @@index([kind])
  @@map("wallets")
}

model WalletTransaction {
  id                     String                @id @default(cuid())
  type                   WalletTransactionType
  senderWalletId         String?               @map("sender_wallet_id")
  recipientWalletId      String                @map("recipient_wallet_id")
  platformWalletId       String?               @map("platform_wallet_id")
  targetType             TipTargetType?        @map("target_type")
  targetThreadId         String?               @map("target_thread_id")
  targetUserId           String?               @map("target_user_id")
  grossAmount            BigInt                @map("gross_amount")
  recipientAmount        BigInt                @map("recipient_amount")
  platformAmount         BigInt                @default(0) @map("platform_amount")
  senderBalanceAfter     BigInt?               @map("sender_balance_after")
  recipientBalanceAfter  BigInt                @map("recipient_balance_after")
  platformBalanceAfter   BigInt?               @map("platform_balance_after")
  threadTipTotalAfter    BigInt?               @map("thread_tip_total_after")
  recipientTipTotalAfter BigInt                @default(0) @map("recipient_tip_total_after")
  recipientTipCountAfter Int                   @default(0) @map("recipient_tip_count_after")
  clientRequestId        String?               @map("client_request_id") @db.Uuid
  requestHash            String?               @map("request_hash")
  dateKey                String?               @map("date_key") @db.VarChar(10)
  createdAt              DateTime              @default(now()) @map("created_at")

  senderWallet    Wallet?       @relation("WalletTransactionSender", fields: [senderWalletId], references: [id], onDelete: Restrict)
  recipientWallet Wallet        @relation("WalletTransactionRecipient", fields: [recipientWalletId], references: [id], onDelete: Restrict)
  platformWallet  Wallet?       @relation("WalletTransactionPlatform", fields: [platformWalletId], references: [id], onDelete: Restrict)
  targetThread    Thread?       @relation(fields: [targetThreadId], references: [id], onDelete: SetNull)
  targetUser      User?         @relation("TipTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  dailyCheckIn    DailyCheckIn?

  @@unique([senderWalletId, clientRequestId])
  @@index([senderWalletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientWalletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetThreadId, createdAt])
  @@map("wallet_transactions")
}

model DailyCheckIn {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  walletId            String   @map("wallet_id")
  walletTransactionId String   @unique @map("wallet_transaction_id")
  dateKey             String   @map("date_key") @db.VarChar(10)
  rewardAmount        BigInt   @map("reward_amount")
  experienceAwarded   Int      @default(2) @map("experience_awarded")
  createdAt           DateTime @default(now()) @map("created_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, dateKey])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("daily_check_ins")
}

model ExperienceEvent {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  type           ExperienceEventType
  delta          Int
  dateKey        String              @map("date_key") @db.VarChar(10)
  idempotencyKey String              @unique @map("idempotency_key")
  sourceType     String?             @map("source_type")
  sourceId       String?             @map("source_id")
  note           String?
  reversedAt     DateTime?           @map("reversed_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sourceType, sourceId])
  @@map("experience_events")
}

model ExperienceDailyStat {
  userId             String   @map("user_id")
  dateKey            String   @map("date_key") @db.VarChar(10)
  checkInCount       Int      @default(0) @map("check_in_count")
  threadPublishCount Int      @default(0) @map("thread_publish_count")
  postCreateCount    Int      @default(0) @map("post_create_count")
  receivedLikeCount  Int      @default(0) @map("received_like_count")
  experienceAwarded  Int      @default(0) @map("experience_awarded")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dateKey])
  @@map("experience_daily_stats")
}

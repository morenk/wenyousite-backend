generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThreadStatus {
  RECRUITING
  CLOSED
  FINISHED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MemberRole {
  OWNER
  COLLABORATOR
  PARTICIPANT
}

enum PostingPolicy {
  PARTICIPANTS
  COLLABORATORS
  PLAYERS
}

enum PostKind {
  BODY
  FLOOR
}

enum ThreadVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  reply
  mention
  new_floor
  subthread_created
  new_post
  thread_created
  follow
  like
  tip
  level_up
  system
}

enum WalletKind {
  USER
  PLATFORM
}

enum WalletTransactionType {
  DAILY_CHECK_IN
  TIP
}

enum TipTargetType {
  THREAD
  USER
  MOMENT
}

enum MomentTextCoverTheme {
  ROSE
  LILAC
  MINT
  AMBER
}

enum ExperienceEventType {
  DAILY_CHECK_IN
  THREAD_PUBLISHED
  POST_CREATED
  THREAD_LIKED
  REVERSAL
}

enum MentionSource {
  DIRECT
  ALL_PLAYERS
}

enum SubscriptionType {
  THREAD
  USER
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum MediaPurpose {
  AVATAR
  PROFILE_COVER
  DIRECT_MESSAGE
  MOMENT
  MOMENT_COMMENT
  RICH_CONTENT
  STICKER_SOURCE
  LEGACY
}

enum DirectConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum StickerImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MobilePlatform {
  ANDROID
  IOS
}

enum ReportTargetType {
  USER
  THREAD
  POST
  MOMENT
  MOMENT_COMMENT
  DIRECT_MESSAGE
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportReasonCode {
  SPAM
  HARASSMENT
  HATE_OR_THREATS
  SEXUAL_CONTENT
  VIOLENT_CONTENT
  PERSONAL_INFORMATION
  IMPERSONATION_OR_FRAUD
  INTELLECTUAL_PROPERTY
  ILLEGAL_CONTENT
  OTHER
}

enum ModerationCaseStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationDecisionAction {
  HIDE_CONTENT
  SUSPEND_USER
  BAN_USER
}

enum ModerationAppealStatus {
  PENDING
  UPHELD
  OVERTURNED
}

enum AdminInviteStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
}

enum AdminSecurityEventType {
  LOGIN_CHALLENGE_CREATED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SESSION_REVOKED
  STEP_UP_SUCCEEDED
  STEP_UP_FAILED
  PRIVATE_EVIDENCE_VIEWED
}

enum NotificationCampaignStatus {
  SCHEDULED
  SENDING
  SENT
  CANCELED
  FAILED
}

enum UserSanctionType {
  SUSPENSION
  BAN
}

enum ContentRemovalSource {
  AUTHOR
  OWNER
  THREAD_MANAGER
  ADMIN
}

enum AuditAction {
  SUPER_ADMIN_BOOTSTRAPPED
  ADMIN_ROLE_GRANTED
  ADMIN_ROLE_REVOKED
  USER_SUSPENDED
  USER_BANNED
  USER_SANCTION_REVOKED
  CONTENT_HIDDEN
  CONTENT_RESTORED
  REPORT_RESOLVED
  REPORT_DISMISSED
  SYSTEM_NOTIFICATION_SENT
  THREAD_CATEGORY_CREATED
  THREAD_CATEGORY_UPDATED
  TAG_CREATED
  TAG_UPDATED
  ADMIN_INVITED
  ADMIN_INVITE_ACCEPTED
  ADMIN_INVITE_CANCELED
  SUPER_ADMIN_TRANSFERRED
  ADMIN_SESSION_REVOKED
  CASE_RESOLVED
  CASE_DISMISSED
  APPEAL_SUBMITTED
  APPEAL_UPHELD
  APPEAL_OVERTURNED
  USER_SESSIONS_REVOKED
  PASSWORD_RESET_REQUESTED_BY_ADMIN
  NOTIFICATION_CAMPAIGN_SCHEDULED
  NOTIFICATION_CAMPAIGN_CANCELED
  THREAD_CATEGORY_MERGED
  TAG_MERGED
  SITE_SETTINGS_UPDATED
}

enum AuditTargetType {
  USER
  THREAD
  POST
  MOMENT
  MOMENT_COMMENT
  REPORT
  SYSTEM_NOTIFICATION
  THREAD_CATEGORY
  TAG
  MODERATION_CASE
  MODERATION_DECISION
  MODERATION_APPEAL
  ADMIN_INVITE
  ADMIN_SESSION
  NOTIFICATION_CAMPAIGN
  SITE_SETTINGS
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  username                  String    @unique
  password                  String
  avatar                    String?
  avatarMediaId             String?   @unique @map("avatar_media_id")
  profileCoverMediaId       String?   @unique @map("profile_cover_media_id")
  profileCoverMobileMediaId String?   @unique @map("profile_cover_mobile_media_id")
  bio                       String?
  role                      UserRole  @default(USER)
  showRecentReplies         Boolean   @default(true) @map("show_recent_replies")
  showPlayerBadges          Boolean   @default(true) @map("show_player_badges")
  showBookmarks             Boolean   @default(true) @map("show_bookmarks")
  deletedAt                 DateTime? @map("deleted_at")
  failedLoginAttempts       Int       @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime? @map("locked_until")
  lastUsernameChange        DateTime? @map("last_username_change")
  experience                Int       @default(0)
  level                     Int       @default(1)
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  ownedThreads  Thread[]       @relation("ThreadOwner")
  threads       ThreadMember[]
  posts         Post[]
  drafts        Draft[]
  likedThreads  ThreadLike[]
  mentions      PostMention[]  @relation("mentionedUser")
  notifications Notification[]

  userBlocks                    UserBlock[]                     @relation("Blocker")
  blockedBy                     UserBlock[]                     @relation("Blocked")
  following                     UserFollow[]                    @relation("Following")
  followers                     UserFollow[]                    @relation("Followers")
  emailVerifications            EmailVerification[]
  subscriptions                 Subscription[]                  @relation("SubscriptionOwner")
  subscriptionsTargeting        Subscription[]                  @relation("SubscriptionTarget")
  sentNotifications             Notification[]                  @relation("NotificationFromUser")
  reportedReports               Report[]                        @relation("Reporter")
  bookmarks                     UserBookmark[]
  bookmarkFolders               BookmarkFolder[]
  handledReports                Report[]                        @relation("Handler")
  auditLogs                     AuditLog[]                      @relation("AuditActor")
  sanctions                     UserSanction[]                  @relation("SanctionedUser")
  sanctionsCreated              UserSanction[]                  @relation("SanctionCreator")
  sanctionsRevoked              UserSanction[]                  @relation("SanctionRevoker")
  media                         Media[]
  avatarMedia                   Media?                          @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  profileCoverMedia             Media?                          @relation("UserProfileCover", fields: [profileCoverMediaId], references: [id], onDelete: SetNull)
  profileCoverMobileMedia       Media?                          @relation("UserProfileCoverMobile", fields: [profileCoverMobileMediaId], references: [id], onDelete: SetNull)
  refreshTokens                 RefreshToken[]
  directConversationsAsFirst    DirectConversation[]            @relation("DirectConversationFirstUser")
  directConversationsAsSecond   DirectConversation[]            @relation("DirectConversationSecondUser")
  sentDirectRequests            DirectConversation[]            @relation("DirectConversationRequester")
  receivedDirectRequests        DirectConversation[]            @relation("DirectConversationRecipient")
  directConversationMemberships DirectConversationParticipant[]
  sentDirectMessages            DirectMessage[]                 @relation("DirectMessageSender")
  receivedDirectMessages        DirectMessage[]                 @relation("DirectMessageRecipient")
  stickerCollection             StickerCollection?
  stickers                      UserSticker[]
  stickerImports                StickerImport[]
  mobileDevices                 MobileDevice[]
  wallet                        Wallet?
  dailyCheckIns                 DailyCheckIn[]
  experienceEvents              ExperienceEvent[]
  experienceDailyStats          ExperienceDailyStat[]
  dailyActivities               UserDailyActivity[]
  targetedTipTransactions       WalletTransaction[]             @relation("TipTargetUser")
  moments                       Moment[]
  momentLikes                   MomentLike[]
  momentBookmarks               MomentBookmark[]
  momentComments                MomentComment[]
  adminSessions                 AdminSession[]
  adminChallenges               AdminAuthChallenge[]
  adminInvitesReceived          AdminInvite[]                   @relation("AdminInviteTarget")
  adminInvitesSent              AdminInvite[]                   @relation("AdminInviteSender")
  adminSecurityEvents           AdminSecurityEvent[]
  moderationCasesResolved       ModerationCase[]                @relation("ModerationCaseResolver")
  moderationDecisionsCreated    ModerationDecision[]            @relation("ModerationDecisionActor")
  moderationDecisionsReversed   ModerationDecision[]            @relation("ModerationDecisionReverser")
  moderationAppeals             ModerationAppeal[]              @relation("ModerationAppealAppellant")
  moderationAppealsHandled      ModerationAppeal[]              @relation("ModerationAppealHandler")
  notificationCampaigns         SystemNotificationCampaign[]

  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_username_trgm_idx")
  @@map("users")
}

model EmailVerification {
  id                String    @id @default(cuid())
  userId            String?   @map("user_id")
  email             String?
  token             String
  type              String    @default("REGISTRATION")
  attempts          Int       @default(0)
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSendAttemptAt DateTime? @map("last_send_attempt_at")
  lastSentAt        DateTime? @map("last_sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, type])
  @@unique([userId, type])
  @@index([token])
  @@map("email_verifications")
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  tokenHash        String    @map("token_hash")
  family           String
  platform         String    @default("web")
  deviceInfo       String?   @map("device_info")
  sessionStartedAt DateTime  @default(now()) @map("session_started_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, family, revokedAt])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AdminAuthChallenge {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  purpose    String    @db.VarChar(32)
  codeHash   String    @map("code_hash") @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("admin_auth_challenges")
}

model AdminSession {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  ip            String?
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  lastActiveAt  DateTime  @default(now()) @map("last_active_at")
  elevatedUntil DateTime? @map("elevated_until")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt, revokedAt])
  @@map("admin_sessions")
}

model AdminInvite {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  invitedById String            @map("invited_by_id")
  tokenHash   String            @unique @map("token_hash") @db.VarChar(64)
  status      AdminInviteStatus @default(PENDING)
  expiresAt   DateTime          @map("expires_at")
  acceptedAt  DateTime?         @map("accepted_at")
  canceledAt  DateTime?         @map("canceled_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  user      User @relation("AdminInviteTarget", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("AdminInviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([invitedById, createdAt(sort: Desc)])
  @@map("admin_invites")
}

model AdminSecurityEvent {
  id        String                 @id @default(cuid())
  userId    String?                @map("user_id")
  type      AdminSecurityEventType
  ip        String?
  userAgent String?                @map("user_agent") @db.VarChar(512)
  metadata  Json?
  expiresAt DateTime               @map("expires_at")
  createdAt DateTime               @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@map("admin_security_events")
}

model MobileDevice {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  sessionId  String         @map("session_id")
  pushToken  String         @unique @map("push_token")
  platform   MobilePlatform
  appVersion String?        @map("app_version")
  locale     String?
  enabled    Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, enabled])
  @@map("mobile_devices")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model ThreadCategoryDefinition {
  id           String   @id @default(cuid())
  slug         String   @unique @db.VarChar(50)
  name         String   @unique @db.VarChar(50)
  description  String?  @db.VarChar(200)
  icon         String?  @db.VarChar(50)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  mergedIntoId String?  @map("merged_into_id")

  threads    Thread[]
  mergedInto ThreadCategoryDefinition?  @relation("ThreadCategoryMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom ThreadCategoryDefinition[] @relation("ThreadCategoryMerges")

  @@index([isActive, sortOrder, name])
  @@map("thread_category_definitions")
}

model Thread {
  id      String  @id @default(cuid())
  title   String?
  ownerId String  @map("owner_id")
  owner   User    @relation("ThreadOwner", fields: [ownerId], references: [id])

  category           String?                   @db.VarChar(50)
  categoryDefinition ThreadCategoryDefinition? @relation(fields: [category], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  status             ThreadStatus              @default(RECRUITING)
  visibility         ThreadVisibility          @default(PUBLIC) @map("visibility")
  published          Boolean                   @default(false) @map("published")
  publishedAt        DateTime?                 @map("published_at")
  clientRequestId    String?                   @map("client_request_id") @db.Uuid
  createRequestHash  String?                   @map("create_request_hash")

  pinned   Boolean   @default(false)
  pinnedAt DateTime?

  viewCount Int    @default(0) @map("view_count")
  version   Int    @default(1) @map("lock_version")
  likeCount Int    @default(0) @map("like_count")
  tipTotal  BigInt @default(0) @map("tip_total")

  defaultSubthreadId String?    @unique @map("default_subthread_id")
  defaultSubthread   Subthread? @relation("DefaultSubthread", fields: [defaultSubthreadId], references: [id], onDelete: SetNull)

  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")
  removalSource ContentRemovalSource? @map("removal_source")
  removedById   String?               @map("removed_by_id")
  removalReason String?               @map("removal_reason")

  members         ThreadMember[]
  subthreads      Subthread[]         @relation("ThreadSubthreads")
  posts           Post[]
  topicTags       ThreadTopicTag[]
  subscriptions   Subscription[]
  notifications   Notification[]
  invites         ThreadInvite[]
  bookmarks       UserBookmark[]
  likes           ThreadLike[]
  tipTransactions WalletTransaction[]

  @@unique([ownerId, clientRequestId])
  @@index([published, visibility, deletedAt, pinned(sort: Desc), createdAt(sort: Desc)], map: "threads_public_created_idx")
  @@index([published, visibility, deletedAt, pinned(sort: Desc), updatedAt(sort: Desc)], map: "threads_public_active_idx")
  @@index([ownerId, published, deletedAt, createdAt(sort: Desc)], map: "threads_owner_created_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "threads_title_trgm_idx")
  @@map("threads")
}

model ThreadLike {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("thread_likes")
}

model ThreadMember {
  id           String     @id @default(cuid())
  threadId     String     @map("thread_id")
  userId       String     @map("user_id")
  role         MemberRole @default(PARTICIPANT)
  playerMarked Boolean    @default(false) @map("player_marked")
  joinedAt     DateTime   @default(now()) @map("joined_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, playerMarked, joinedAt(sort: Desc)], map: "thread_members_user_played_idx")
  @@index([userId, role, threadId], map: "thread_members_user_role_thread_idx")
  @@map("thread_members")
}

model Subthread {
  id                String        @id @default(cuid())
  threadId          String        @map("thread_id")
  title             String
  sortOrder         Int           @default(0) @map("sort_order")
  postingPolicy     PostingPolicy @default(PARTICIPANTS) @map("posting_policy")
  version           Int           @default(1) @map("lock_version")
  lastPostAt        DateTime?     @map("last_post_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  clientRequestId   String?       @map("client_request_id") @db.Uuid
  createRequestHash String?       @map("create_request_hash")

  thread           Thread  @relation("ThreadSubthreads", fields: [threadId], references: [id], onDelete: Cascade)
  defaultForThread Thread? @relation("DefaultSubthread")
  posts            Post[]

  // Active sort-order uniqueness is enforced by the partial index
  // subthreads_thread_id_sort_order_active_key in the migration SQL.
  @@unique([threadId, id], map: "subthreads_thread_id_id_key")
  @@unique([threadId, clientRequestId])
  @@map("subthreads")
}

model TopicTag {
  id           String   @id @default(cuid())
  name         String   @unique
  color        String?  @db.VarChar(7)
  description  String?  @db.VarChar(200)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  mergedIntoId String?  @map("merged_into_id")

  threads    ThreadTopicTag[]
  mergedInto TopicTag?        @relation("TopicTagMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom TopicTag[]       @relation("TopicTagMerges")

  @@index([isActive, sortOrder, name])
  @@map("topic_tags")
}

model ThreadTopicTag {
  id       String @id @default(cuid())
  threadId String @map("thread_id")
  tagId    String @map("tag_id")

  thread Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    TopicTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([threadId, tagId])
  @@map("thread_topic_tags")
}

model Subscription {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  threadId     String           @map("thread_id")
  targetUserId String?          @map("target_user_id")
  type         SubscriptionType @default(THREAD)
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User   @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User?  @relation("SubscriptionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  thread     Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId, targetUserId])
  @@index([userId, type])
  @@map("subscriptions")
}

model ThreadInvite {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId])
  @@map("thread_invites")
}

model UserBookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  threadId  String   @map("thread_id")
  folderId  String   @map("folder_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  folder BookmarkFolder @relation(fields: [folderId], references: [id], onDelete: Restrict)

  @@unique([userId, threadId])
  @@index([folderId, createdAt(sort: Desc)])
  @@map("user_bookmarks")
}

model BookmarkFolder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @db.VarChar(24)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks       UserBookmark[]
  momentBookmarks MomentBookmark[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("bookmark_folders")
}

model Moment {
  id                String                @id @default(cuid())
  authorId          String                @map("author_id")
  title             String                @db.VarChar(40)
  content           String                @default("") @db.VarChar(1000)
  textCoverTheme    MomentTextCoverTheme  @default(ROSE) @map("text_cover_theme")
  coverMediaId      String?               @map("cover_media_id")
  clientRequestId   String                @map("client_request_id") @db.Uuid
  createRequestHash String                @map("create_request_hash")
  likeCount         Int                   @default(0) @map("like_count")
  commentCount      Int                   @default(0) @map("comment_count")
  bookmarkCount     Int                   @default(0) @map("bookmark_count")
  tipTotal          BigInt                @default(0) @map("tip_total")
  version           Int                   @default(1) @map("lock_version")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  deletedAt         DateTime?             @map("deleted_at")
  removalSource     ContentRemovalSource? @map("removal_source")
  removedById       String?               @map("removed_by_id")
  removalReason     String?               @map("removal_reason")

  author          User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  coverMedia      Media?              @relation("MomentCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  images          MomentImage[]
  likes           MomentLike[]
  bookmarks       MomentBookmark[]
  comments        MomentComment[]
  notifications   Notification[]
  tipTransactions WalletTransaction[]

  @@unique([authorId, clientRequestId])

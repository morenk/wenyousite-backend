  content          String                     @db.VarChar(1000)
  destinationType  String?                    @map("destination_type") @db.VarChar(32)
  destinationId    String?                    @map("destination_id")
  audience         Json
  status           NotificationCampaignStatus @default(SCHEDULED)
  scheduledAt      DateTime                   @map("scheduled_at")
  startedAt        DateTime?                  @map("started_at")
  sentAt           DateTime?                  @map("sent_at")
  canceledAt       DateTime?                  @map("canceled_at")
  estimatedCount   Int                        @default(0) @map("estimated_count")
  recipientCount   Int                        @default(0) @map("recipient_count")
  dispatchCursor   String?                    @map("dispatch_cursor")
  dispatchAttempts Int                        @default(0) @map("dispatch_attempts")
  lastAttemptAt    DateTime?                  @map("last_attempt_at")
  failureMessage   String?                    @map("failure_message")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([status, scheduledAt])
  @@index([status, lastAttemptAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("system_notification_campaigns")
}

model SiteOperationalSettings {
  id                       String    @id @default("default")
  registrationPausedUntil  DateTime? @map("registration_paused_until")
  contentWritesPausedUntil DateTime? @map("content_writes_paused_until")
  maintenanceTitle         String?   @map("maintenance_title") @db.VarChar(60)
  maintenanceContent       String?   @map("maintenance_content") @db.VarChar(500)
  maintenanceStartsAt      DateTime? @map("maintenance_starts_at")
  maintenanceEndsAt        DateTime? @map("maintenance_ends_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("site_operational_settings")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)], map: "user_follows_followers_idx")
  @@map("user_follows")
}

/// 与业务写入同事务提交的领域事件；由后台分发器可靠投递到进程内监听器和 BullMQ。
model DomainOutbox {
  id            String    @id @default(cuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id")
  eventKey      String    @unique @map("event_key")
  payload       Json
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([processedAt, availableAt, createdAt], map: "domain_outbox_pending_idx")
  @@map("domain_outbox")
}

model Wallet {
  id               String     @id @default(cuid())
  kind             WalletKind
  userId           String?    @unique @map("user_id")
  balance          BigInt     @default(0)
  receivedTipTotal BigInt     @default(0) @map("received_tip_total")
  receivedTipCount Int        @default(0) @map("received_tip_count")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user                 User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentTransactions     WalletTransaction[] @relation("WalletTransactionSender")
  receivedTransactions WalletTransaction[] @relation("WalletTransactionRecipient")
  platformTransactions WalletTransaction[] @relation("WalletTransactionPlatform")
  dailyCheckIns        DailyCheckIn[]

  @@index([kind])
  @@map("wallets")
}

model WalletTransaction {
  id                     String                @id @default(cuid())
  type                   WalletTransactionType
  senderWalletId         String?               @map("sender_wallet_id")
  recipientWalletId      String                @map("recipient_wallet_id")
  platformWalletId       String?               @map("platform_wallet_id")
  targetType             TipTargetType?        @map("target_type")
  targetThreadId         String?               @map("target_thread_id")
  targetUserId           String?               @map("target_user_id")
  targetMomentId         String?               @map("target_moment_id")
  grossAmount            BigInt                @map("gross_amount")
  recipientAmount        BigInt                @map("recipient_amount")
  platformAmount         BigInt                @default(0) @map("platform_amount")
  senderBalanceAfter     BigInt?               @map("sender_balance_after")
  recipientBalanceAfter  BigInt                @map("recipient_balance_after")
  platformBalanceAfter   BigInt?               @map("platform_balance_after")
  threadTipTotalAfter    BigInt?               @map("thread_tip_total_after")
  momentTipTotalAfter    BigInt?               @map("moment_tip_total_after")
  recipientTipTotalAfter BigInt                @default(0) @map("recipient_tip_total_after")
  recipientTipCountAfter Int                   @default(0) @map("recipient_tip_count_after")
  clientRequestId        String?               @map("client_request_id") @db.Uuid
  requestHash            String?               @map("request_hash")
  dateKey                String?               @map("date_key") @db.VarChar(10)
  createdAt              DateTime              @default(now()) @map("created_at")

  senderWallet    Wallet?       @relation("WalletTransactionSender", fields: [senderWalletId], references: [id], onDelete: Restrict)
  recipientWallet Wallet        @relation("WalletTransactionRecipient", fields: [recipientWalletId], references: [id], onDelete: Restrict)
  platformWallet  Wallet?       @relation("WalletTransactionPlatform", fields: [platformWalletId], references: [id], onDelete: Restrict)
  targetThread    Thread?       @relation(fields: [targetThreadId], references: [id], onDelete: Restrict)
  targetUser      User?         @relation("TipTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetMoment    Moment?       @relation(fields: [targetMomentId], references: [id], onDelete: Restrict)
  dailyCheckIn    DailyCheckIn?

  @@unique([senderWalletId, clientRequestId])
  @@index([senderWalletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientWalletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetThreadId, createdAt])
  @@index([targetMomentId, createdAt])
  @@map("wallet_transactions")
}

model DailyCheckIn {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  walletId            String   @map("wallet_id")
  walletTransactionId String   @unique @map("wallet_transaction_id")
  dateKey             String   @map("date_key") @db.VarChar(10)
  rewardAmount        BigInt   @map("reward_amount")
  experienceAwarded   Int      @default(2) @map("experience_awarded")
  createdAt           DateTime @default(now()) @map("created_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, dateKey])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("daily_check_ins")
}

model ExperienceEvent {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  type           ExperienceEventType
  delta          Int
  dateKey        String              @map("date_key") @db.VarChar(10)
  idempotencyKey String              @unique @map("idempotency_key")
  sourceType     String?             @map("source_type")
  sourceId       String?             @map("source_id")
  note           String?
  reversedAt     DateTime?           @map("reversed_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sourceType, sourceId])
  @@map("experience_events")
}

model ExperienceDailyStat {
  userId             String   @map("user_id")
  dateKey            String   @map("date_key") @db.VarChar(10)
  checkInCount       Int      @default(0) @map("check_in_count")
  threadPublishCount Int      @default(0) @map("thread_publish_count")
  postCreateCount    Int      @default(0) @map("post_create_count")
  receivedLikeCount  Int      @default(0) @map("received_like_count")
  experienceAwarded  Int      @default(0) @map("experience_awarded")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dateKey])
  @@map("experience_daily_stats")
}

/// 管理看板的低基数活跃事实：北京时间内每个普通用户每天最多一行，不记录访问路径或 IP。
model UserDailyActivity {
  userId      String   @map("user_id")
  dateKey     String   @map("date_key") @db.VarChar(10)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dateKey])
  @@index([dateKey, userId])
  @@map("user_daily_activities")
}
